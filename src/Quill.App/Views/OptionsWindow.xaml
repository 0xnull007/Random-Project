<Window x:Class="Quill.App.Views.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Options"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20,16,20,16">
    <TextBlock Text="Saving" FontWeight="SemiBold" Margin="0,0,0,6" />
    <StackPanel Orientation="Horizontal">
      <TextBlock Text="Autosave unsaved changes every" VerticalAlignment="Center" Margin="0,0,8,0" />
      <ComboBox x:Name="AutosaveBox" Width="70" IsEditable="True" />
      <TextBlock Text="minutes (0 = off)" VerticalAlignment="Center" Margin="8,0,0,0" />
    </StackPanel>

    <TextBlock Text="AutoCorrect while typing" FontWeight="SemiBold" Margin="0,16,0,6" />
    <CheckBox x:Name="QuotesBox" Content='"Straight quotes" with “smart quotes”' Margin="0,2" />
    <CheckBox x:Name="DashesBox" Content="Hyphens (--) with a dash (—)" Margin="0,2" />
    <CheckBox x:Name="SymbolsBox" Content="Symbols: (c) (r) (tm) ... --> 1/2" Margin="0,2" />
    <CheckBox x:Name="CapitalizeBox" Content="Capitalize the first letter of sentences" Margin="0,2" />
    <CheckBox x:Name="ListsBox" Content="Automatic bulleted and numbered lists (* and 1. followed by a space)" Margin="0,2" />

    <TextBlock Text="Proofing" FontWeight="SemiBold" Margin="0,16,0,6" />
    <CheckBox x:Name="SpellingBox" Content="Check spelling as you type (uses the Windows spell checker and its dictionaries)" Margin="0,2" />

    <TextBlock Text="Measurements" FontWeight="SemiBold" Margin="0,16,0,6" />
    <StackPanel Orientation="Horizontal">
      <TextBlock Text="Show lengths in" VerticalAlignment="Center" Margin="0,0,8,0" />
      <ComboBox x:Name="UnitsBox" Width="200">
        <ComboBoxItem Content="Windows region setting" Tag="Auto" />
        <ComboBoxItem Content="Inches" Tag="Inches" />
        <ComboBoxItem Content="Centimeters" Tag="Centimeters" />
      </ComboBox>
    </StackPanel>

    <TextBlock x:Name="ErrorText" Foreground="#FFD13438" Margin="0,6,0,0" Visibility="Collapsed" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="OK" Width="90" IsDefault="True" Click="OnOk" Margin="0,0,8,0" />
      <Button Content="Cancel" Width="90" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
