<Window x:Class="Quill.App.Views.InsertTableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Insert Table"
        Width="300" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20,16,20,16">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition />
      </Grid.RowDefinitions>
      <TextBlock Text="Columns:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,6" />
      <TextBox x:Name="ColumnsBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" HorizontalContentAlignment="Right" Text="3" />
      <TextBlock Text="Rows:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0" />
      <TextBox x:Name="RowsBox" Grid.Row="1" Grid.Column="1" HorizontalContentAlignment="Right" Text="3" />
    </Grid>
    <TextBlock Text="The table fills the width of the text column; columns share it equally." Margin="0,8,0,0" Opacity="0.75" TextWrapping="Wrap" />
    <TextBlock x:Name="ErrorText" Foreground="#FFD13438" Margin="0,6,0,0" Visibility="Collapsed" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="OK" Width="90" IsDefault="True" Click="OnOk" Margin="0,0,8,0" />
      <Button Content="Cancel" Width="90" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
