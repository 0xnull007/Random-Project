<Window x:Class="Quill.App.Views.WordCountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Word Count"
        Width="360" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20,16,20,16">
    <TextBlock x:Name="Scope" FontWeight="SemiBold" Margin="0,0,0,8" />
    <Grid x:Name="Table">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
    </Grid>
    <Button Content="Close" Width="90" HorizontalAlignment="Right" Margin="0,16,0,0" IsCancel="True" IsDefault="True" />
  </StackPanel>
</Window>
