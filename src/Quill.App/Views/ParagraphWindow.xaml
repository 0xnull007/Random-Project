<Window x:Class="Quill.App.Views.ParagraphWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paragraph"
        Width="480" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20,16,20,16">
    <TextBlock Text="General" FontWeight="SemiBold" Margin="0,0,0,6" />
    <StackPanel Orientation="Horizontal">
      <TextBlock Text="Alignment:" VerticalAlignment="Center" Margin="0,0,8,0" />
      <ComboBox x:Name="AlignmentBox" Width="140">
        <ComboBoxItem Content="Left" />
        <ComboBoxItem Content="Centered" />
        <ComboBoxItem Content="Right" />
        <ComboBoxItem Content="Justified" />
      </ComboBox>
    </StackPanel>

    <TextBlock Text="Indentation" FontWeight="SemiBold" Margin="0,14,0,6" />
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="90" /><ColumnDefinition Width="30" />
        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="110" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="80" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
      <TextBlock Text="Left:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,6" />
      <TextBox x:Name="LeftBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" HorizontalContentAlignment="Right" />
      <TextBlock Text="Right:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0" />
      <TextBox x:Name="RightBox" Grid.Row="1" Grid.Column="1" HorizontalContentAlignment="Right" />
      <TextBlock Text="Special:" Grid.Row="0" Grid.Column="3" VerticalAlignment="Center" Margin="0,0,8,6" />
      <ComboBox x:Name="SpecialBox" Grid.Row="0" Grid.Column="4" Margin="0,0,0,6" SelectionChanged="OnSpecialChanged">
        <ComboBoxItem Content="(none)" />
        <ComboBoxItem Content="First line" />
        <ComboBoxItem Content="Hanging" />
      </ComboBox>
      <TextBlock Text="By:" Grid.Row="0" Grid.Column="5" VerticalAlignment="Center" Margin="8,0,8,6" />
      <TextBox x:Name="ByBox" Grid.Row="0" Grid.Column="6" Margin="0,0,0,6" HorizontalContentAlignment="Right" />
      <TextBlock x:Name="UnitHint" Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="4" Opacity="0.7" VerticalAlignment="Center" />
    </Grid>

    <TextBlock Text="Spacing" FontWeight="SemiBold" Margin="0,14,0,6" />
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="90" /><ColumnDefinition Width="30" />
        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="110" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="80" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
      <TextBlock Text="Before:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,6" />
      <TextBox x:Name="BeforeBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" HorizontalContentAlignment="Right" ToolTip="Points" />
      <TextBlock Text="After:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0" />
      <TextBox x:Name="AfterBox" Grid.Row="1" Grid.Column="1" HorizontalContentAlignment="Right" ToolTip="Points" />
      <TextBlock Text="Line spacing:" Grid.Row="0" Grid.Column="3" VerticalAlignment="Center" Margin="0,0,8,6" />
      <ComboBox x:Name="LineBox" Grid.Row="0" Grid.Column="4" Margin="0,0,0,6" SelectionChanged="OnLineChanged">
        <ComboBoxItem Content="Single" />
        <ComboBoxItem Content="1.5 lines" />
        <ComboBoxItem Content="Double" />
        <ComboBoxItem Content="At least" />
        <ComboBoxItem Content="Exactly" />
        <ComboBoxItem Content="Multiple" />
      </ComboBox>
      <TextBlock Text="At:" Grid.Row="0" Grid.Column="5" VerticalAlignment="Center" Margin="8,0,8,6" />
      <TextBox x:Name="AtBox" Grid.Row="0" Grid.Column="6" Margin="0,0,0,6" HorizontalContentAlignment="Right" />
      <TextBlock x:Name="AtHint" Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="4" Opacity="0.7" VerticalAlignment="Center" />
    </Grid>
    <CheckBox x:Name="ContextualBox" Content="Don't add space between paragraphs of the same style" Margin="0,8,0,0" />

    <TextBlock Text="Line and page breaks" FontWeight="SemiBold" Margin="0,14,0,6" />
    <WrapPanel>
      <CheckBox x:Name="WidowBox" Content="Widow/Orphan control" Margin="0,2,16,2" />
      <CheckBox x:Name="KeepNextBox" Content="Keep with next" Margin="0,2,16,2" />
      <CheckBox x:Name="KeepLinesBox" Content="Keep lines together" Margin="0,2,16,2" />
      <CheckBox x:Name="PageBreakBox" Content="Page break before" Margin="0,2,16,2" />
    </WrapPanel>
    <TextBlock x:Name="ErrorText" Foreground="#FFD13438" Margin="0,6,0,0" Visibility="Collapsed" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="OK" Width="90" IsDefault="True" Click="OnOk" Margin="0,0,8,0" />
      <Button Content="Cancel" Width="90" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
