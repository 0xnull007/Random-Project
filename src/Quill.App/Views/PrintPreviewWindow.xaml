<Window x:Class="Quill.App.Views.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Quill.App.Views"
        Title="Print Preview"
        Width="1000" Height="820" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,6">
      <Button Style="{StaticResource Quill.CommandButton}" Content="Print..." Click="OnPrint" ToolTip="Print (Ctrl+P)" />
      <Button Style="{StaticResource Quill.CommandButton}" Content="Export PDF..." Click="OnExportPdf" />
      <Border Style="{StaticResource Quill.CommandDivider}" />
      <Button Style="{StaticResource Quill.CommandButton}" Content="Fit Page" Click="OnFitPage" />
      <Button Style="{StaticResource Quill.CommandButton}" Content="Fit Width" Click="OnFitWidth" />
      <Button Style="{StaticResource Quill.CommandButton}" Content="100%" Click="OnZoom100" />
      <Button Style="{StaticResource Quill.CommandButton}" Content="-" Click="OnZoomOut" ToolTip="Zoom out" />
      <Button Style="{StaticResource Quill.CommandButton}" Content="+" Click="OnZoomIn" ToolTip="Zoom in" />
      <TextBlock x:Name="PageInfo" VerticalAlignment="Center" Margin="12,0" />
      <Border Style="{StaticResource Quill.CommandDivider}" />
      <Button Style="{StaticResource Quill.CommandButton}" Content="Close" IsCancel="True" />
    </StackPanel>
    <ScrollViewer CanContentScroll="True"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Visible"
                  PanningMode="Both"
                  Focusable="False">
      <views:DocumentView x:Name="Preview" IsReadOnly="True" />
    </ScrollViewer>
  </DockPanel>
</Window>
