<Window x:Class="Quill.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Quill.App.Views"
        xmlns:vm="clr-namespace:Quill.App.ViewModels"
        Title="{Binding Title}"
        Width="1200" Height="820" MinWidth="700" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
  <Window.DataContext>
    <vm:MainViewModel />
  </Window.DataContext>
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </Window.Resources>
  <Window.InputBindings>
    <KeyBinding Modifiers="Ctrl" Key="B" Command="{Binding ToggleBoldCommand}" />
    <KeyBinding Modifiers="Ctrl" Key="I" Command="{Binding ToggleItalicCommand}" />
    <KeyBinding Modifiers="Ctrl" Key="U" Command="{Binding ToggleUnderlineCommand}" />
    <KeyBinding Modifiers="Ctrl" Key="L" Command="{Binding AlignCommand}" CommandParameter="Left" />
    <KeyBinding Modifiers="Ctrl" Key="E" Command="{Binding AlignCommand}" CommandParameter="Center" />
    <KeyBinding Modifiers="Ctrl" Key="R" Command="{Binding AlignCommand}" CommandParameter="Right" />
    <KeyBinding Modifiers="Ctrl" Key="J" Command="{Binding AlignCommand}" CommandParameter="Justify" />
    <KeyBinding Modifiers="Ctrl" Key="N" Command="{Binding NewDocumentCommand}" />
    <KeyBinding Modifiers="Ctrl" Key="O" Command="{Binding OpenCommand}" />
    <KeyBinding Modifiers="Ctrl" Key="S" Command="{Binding SaveCommand}" />
    <KeyBinding Key="F12" Command="{Binding SaveAsCommand}" />
    <KeyBinding Modifiers="Ctrl" Key="P" Command="{Binding PrintCommand}" />
    <KeyBinding Modifiers="Ctrl" Key="Z" Command="{Binding UndoCommand}" />
    <KeyBinding Modifiers="Ctrl" Key="Y" Command="{Binding RedoCommand}" />
    <KeyBinding Modifiers="Ctrl+Shift" Key="OemPeriod" Command="{Binding GrowFontCommand}" />
    <KeyBinding Modifiers="Ctrl+Shift" Key="OemComma" Command="{Binding ShrinkFontCommand}" />
    <KeyBinding Modifiers="Ctrl" Key="OemCloseBrackets" Command="{Binding NudgeFontCommand}" CommandParameter="1" />
    <KeyBinding Modifiers="Ctrl" Key="OemOpenBrackets" Command="{Binding NudgeFontCommand}" CommandParameter="-1" />
    <KeyBinding Modifiers="Ctrl+Shift" Key="OemPlus" Command="{Binding ToggleSuperscriptCommand}" />
    <KeyBinding Modifiers="Ctrl+Alt" Key="D1" Command="{Binding ApplyHeadingCommand}" CommandParameter="1" />
    <KeyBinding Modifiers="Ctrl+Alt" Key="D2" Command="{Binding ApplyHeadingCommand}" CommandParameter="2" />
    <KeyBinding Modifiers="Ctrl+Alt" Key="D3" Command="{Binding ApplyHeadingCommand}" CommandParameter="3" />
    <KeyBinding Modifiers="Ctrl+Shift" Key="N" Command="{Binding ApplyHeadingCommand}" CommandParameter="0" />
    <KeyBinding Modifiers="Ctrl" Key="D1" Command="{Binding SetLineSpacingCommand}" CommandParameter="1.0" />
    <KeyBinding Modifiers="Ctrl" Key="D2" Command="{Binding SetLineSpacingCommand}" CommandParameter="2.0" />
    <KeyBinding Modifiers="Ctrl" Key="D5" Command="{Binding SetLineSpacingCommand}" CommandParameter="1.5" />
    <KeyBinding Modifiers="Ctrl" Key="OemPlus" Command="{Binding ZoomInCommand}" />
    <KeyBinding Modifiers="Ctrl" Key="Add" Command="{Binding ZoomInCommand}" />
    <KeyBinding Modifiers="Ctrl" Key="OemMinus" Command="{Binding ZoomOutCommand}" />
    <KeyBinding Modifiers="Ctrl" Key="Subtract" Command="{Binding ZoomOutCommand}" />
    <KeyBinding Key="F3" Command="{x:Static views:MainWindow.FindNextCommand}" />
    <KeyBinding Key="F3" Modifiers="Shift" Command="{Binding CycleCaseCommand}" />
    <KeyBinding Key="F4" Modifiers="Shift" Command="{x:Static views:MainWindow.FindPreviousCommand}" />
    <KeyBinding Modifiers="Ctrl" Key="G" Command="{x:Static views:MainWindow.GoToPageCommand}" />
    <KeyBinding Modifiers="Ctrl+Shift" Key="G" Command="{x:Static views:MainWindow.WordCountCommand}" />
    <KeyBinding Key="F1" Command="{x:Static views:MainWindow.ShortcutsCommand}" />
    <KeyBinding Modifiers="Ctrl+Shift" Key="C" Command="{Binding CopyFormatCommand}" />
    <KeyBinding Modifiers="Ctrl+Shift" Key="V" Command="{Binding PasteFormatCommand}" />
    <KeyBinding Modifiers="Ctrl+Alt" Key="V" Command="{x:Static views:MainWindow.PastePlainCommand}" />
    <KeyBinding Modifiers="Ctrl" Key="Space" Command="{Binding ClearFormattingCommand}" />
  </Window.InputBindings>
  <Window.CommandBindings>
    <CommandBinding Command="ApplicationCommands.Find" Executed="OnFind" />
    <CommandBinding Command="ApplicationCommands.Replace" Executed="OnReplace" />
    <CommandBinding Command="{x:Static views:MainWindow.FindNextCommand}" Executed="OnFindNext" />
    <CommandBinding Command="{x:Static views:MainWindow.FindPreviousCommand}" Executed="OnFindPrevious" />
    <CommandBinding Command="{x:Static views:MainWindow.GoToPageCommand}" Executed="OnGoToPageCommand" />
    <CommandBinding Command="{x:Static views:MainWindow.WordCountCommand}" Executed="OnWordCountCommand" />
    <CommandBinding Command="{x:Static views:MainWindow.ShortcutsCommand}" Executed="OnShortcutsCommand" />
    <CommandBinding Command="{x:Static views:MainWindow.PastePlainCommand}" Executed="OnPastePlain" />
  </Window.CommandBindings>

  <DockPanel>
    <!-- One compact command bar (Word's "simplified ribbon"): tabs on top, a single row of controls below. -->
    <TabControl x:Name="Tabs" DockPanel.Dock="Top" SelectedIndex="1" Margin="0" Padding="6,3" BorderThickness="0,0,0,1" SelectionChanged="OnTabChanged">
      <TabItem Header="File">
        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource Quill.CommandButton}" Content="New" Command="{Binding NewDocumentCommand}" ToolTip="New document (Ctrl+N)" />
          <Button Style="{StaticResource Quill.CommandButton}" Content="Open..." Command="{Binding OpenCommand}" ToolTip="Open a .docx (Ctrl+O)" />
          <Button Style="{StaticResource Quill.CommandButton}" Content="Save" Command="{Binding SaveCommand}" ToolTip="Save (Ctrl+S)" />
          <Button Style="{StaticResource Quill.CommandButton}" Content="Save As..." Command="{Binding SaveAsCommand}" />
          <Border Style="{StaticResource Quill.CommandDivider}" />
          <TextBlock Text="Recent:" VerticalAlignment="Center" Margin="2,0,4,0" FontSize="13" />
          <ComboBox Style="{StaticResource Quill.CommandCombo}" Width="220" ItemsSource="{Binding RecentFiles}" SelectedItem="{Binding SelectedRecent}" DisplayMemberPath="Name" ToolTip="Recently opened files" />
          <Border Style="{StaticResource Quill.CommandDivider}" />
          <Button Style="{StaticResource Quill.CommandButton}" Content="Print..." Command="{Binding PrintCommand}" ToolTip="Print (Ctrl+P)" />
          <Button Style="{StaticResource Quill.CommandButton}" Content="Print Preview" Click="OnPrintPreview" ToolTip="See the pages exactly as they will print" />
          <Button Style="{StaticResource Quill.CommandButton}" Content="Export PDF..." Command="{Binding ExportPdfCommand}" ToolTip="Save the document as a PDF file" />
          <Button Style="{StaticResource Quill.CommandButton}" Content="Properties..." Click="OnProperties" ToolTip="Title, author, subject and comments stored in the file" />
          <Border Style="{StaticResource Quill.CommandDivider}" />
          <Button Style="{StaticResource Quill.CommandButton}" Content="Shortcuts" Click="OnShortcuts" ToolTip="Keyboard shortcuts (F1)" />
          <Button Style="{StaticResource Quill.CommandButton}" Content="About" Click="OnAbout" />
          <Border Style="{StaticResource Quill.CommandDivider}" />
          <Button Style="{StaticResource Quill.CommandButton}" Content="Exit" Click="OnExit" />
        </StackPanel>
      </TabItem>

      <TabItem Header="Home">
        <WrapPanel Orientation="Horizontal">
          <Button Style="{StaticResource Quill.CommandButton}" Content="Cut" Click="OnCut" ToolTip="Cut (Ctrl+X)" />
          <Button Style="{StaticResource Quill.CommandButton}" Content="Copy" Click="OnCopy" ToolTip="Copy (Ctrl+C)" />
          <Button Style="{StaticResource Quill.CommandButton}" Content="Paste" Click="OnPaste" ToolTip="Paste (Ctrl+V)" />
          <Button Style="{StaticResource Quill.CommandButton}" Content="Clear" Command="{Binding ClearFormattingCommand}" ToolTip="Clear character formatting (Ctrl+Space)" />
          <ToggleButton Style="{StaticResource Quill.CommandToggle}" x:Name="PainterButton" Content="Format Painter" IsChecked="{Binding IsFormatPainterActive}" MouseDoubleClick="OnPainterDoubleClick" ToolTip="Copy the formatting here to the text you click or drag over next; double-click to keep it on (Ctrl+Shift+C / Ctrl+Shift+V)" />
          <Border Style="{StaticResource Quill.CommandDivider}" />
          <ComboBox Style="{StaticResource Quill.CommandCombo}" Width="150" IsEditable="True"
                    ItemsSource="{Binding FontFamilies}" Text="{Binding FontFamily, UpdateSourceTrigger=LostFocus}"
                    ToolTip="Font" />
          <ComboBox Style="{StaticResource Quill.CommandCombo}" Width="64"
                    ItemsSource="{Binding FontSizes}" SelectedItem="{Binding FontSize}"
                    ToolTip="Font size" />
          <Button Style="{StaticResource Quill.CommandButton}" Content="A&#x2191;" Command="{Binding GrowFontCommand}" ToolTip="Grow font (Ctrl+Shift+&gt;)" />
          <Button Style="{StaticResource Quill.CommandButton}" Content="A&#x2193;" Command="{Binding ShrinkFontCommand}" ToolTip="Shrink font (Ctrl+Shift+&lt;)" />
          <Button Style="{StaticResource Quill.CommandButton}" Content="Aa" Click="OnCaseMenu" ToolTip="Change case (Shift+F3 cycles lowercase, UPPERCASE, Capitalize Each Word)">
            <Button.ContextMenu>
              <ContextMenu Closed="OnMenuClosed">
                <MenuItem Header="Sentence case." Command="{Binding ChangeCaseCommand}" CommandParameter="Sentence" />
                <MenuItem Header="lowercase" Command="{Binding ChangeCaseCommand}" CommandParameter="Lower" />
                <MenuItem Header="UPPERCASE" Command="{Binding ChangeCaseCommand}" CommandParameter="Upper" />
                <MenuItem Header="Capitalize Each Word" Command="{Binding ChangeCaseCommand}" CommandParameter="TitleCase" />
                <MenuItem Header="tOGGLE cASE" Command="{Binding ChangeCaseCommand}" CommandParameter="Toggle" />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
          <Border Style="{StaticResource Quill.CommandDivider}" />
          <ToggleButton Style="{StaticResource Quill.CommandToggle}" IsChecked="{Binding IsBold}" FontWeight="Bold" Content="B" ToolTip="Bold (Ctrl+B)" />
          <ToggleButton Style="{StaticResource Quill.CommandToggle}" IsChecked="{Binding IsItalic}" FontStyle="Italic" Content="I" ToolTip="Italic (Ctrl+I)" />
          <ToggleButton Style="{StaticResource Quill.CommandToggle}" IsChecked="{Binding IsUnderline}" ToolTip="Underline (Ctrl+U)">
            <TextBlock Text="U" TextDecorations="Underline" />
          </ToggleButton>
          <ToggleButton Style="{StaticResource Quill.CommandToggle}" IsChecked="{Binding IsStrikethrough}" ToolTip="Strikethrough">
            <TextBlock Text="S" TextDecorations="Strikethrough" />
          </ToggleButton>
          <ToggleButton Style="{StaticResource Quill.CommandToggle}" IsChecked="{Binding IsSuperscript}" Content="x&#xB2;" ToolTip="Superscript (Ctrl+Shift+Plus)" />
          <ToggleButton Style="{StaticResource Quill.CommandToggle}" IsChecked="{Binding IsSubscript}" Content="x&#x2082;" ToolTip="Subscript" />
          <views:ColorPickerButton x:Name="FontColorPicker" GlyphText="A" ToggleToolTip="Font color" CurrentColor="{Binding FontColor}" ColorSelected="OnFontColorSelected" />
          <views:ColorPickerButton x:Name="HighlightPicker" IsHighlight="True" GlyphText="ab" ToggleToolTip="Text highlight color" CurrentColor="{Binding HighlightSwatch}" ColorSelected="OnHighlightSelected" />
          <Border Style="{StaticResource Quill.CommandDivider}" />
          <ToggleButton Style="{StaticResource Quill.CommandToggle}" IsChecked="{Binding IsAlignLeft}" Content="&#x2630;" ToolTip="Align left (Ctrl+L)" />
          <ToggleButton Style="{StaticResource Quill.CommandToggle}" IsChecked="{Binding IsAlignCenter}" Content="&#x2261;" ToolTip="Center (Ctrl+E)" />
          <ToggleButton Style="{StaticResource Quill.CommandToggle}" IsChecked="{Binding IsAlignRight}" Content="&#x2630;" ToolTip="Align right (Ctrl+R)" />
          <ToggleButton Style="{StaticResource Quill.CommandToggle}" IsChecked="{Binding IsAlignJustify}" Content="&#x2261;" ToolTip="Justify (Ctrl+J)" />
          <Border Style="{StaticResource Quill.CommandDivider}" />
          <ToggleButton Style="{StaticResource Quill.CommandToggle}" IsChecked="{Binding IsBulleted}" Content="&#x2022; List" ToolTip="Bulleted list" />
          <ToggleButton Style="{StaticResource Quill.CommandToggle}" IsChecked="{Binding IsNumbered}" Content="1. List" ToolTip="Numbered list" />
          <Button Style="{StaticResource Quill.CommandButton}" Content="&#x21E4;" Command="{Binding DecreaseIndentCommand}" ToolTip="Decrease indent (Shift+Tab at the start of a list item)" />
          <Button Style="{StaticResource Quill.CommandButton}" Content="&#x21E5;" Command="{Binding IncreaseIndentCommand}" ToolTip="Increase indent (Tab at the start of a list item)" />
          <Border Style="{StaticResource Quill.CommandDivider}" />
          <TextBlock Text="&#x2195;" VerticalAlignment="Center" Margin="2,0" ToolTip="Line spacing" />
          <ComboBox Style="{StaticResource Quill.CommandCombo}" Width="62" ItemsSource="{Binding LineSpacingChoices}" SelectedItem="{Binding LineSpacingValue}" ToolTip="Line spacing (Ctrl+1, Ctrl+2, Ctrl+5)" />
          <TextBlock Text="Before" VerticalAlignment="Center" Margin="6,0,2,0" FontSize="11" Opacity="0.8" />
          <ComboBox Style="{StaticResource Quill.CommandCombo}" Width="54" ItemsSource="{Binding ParagraphSpacingChoices}" SelectedItem="{Binding SpaceBeforePoints}" ToolTip="Space before paragraph (pt)" />
          <TextBlock Text="After" VerticalAlignment="Center" Margin="6,0,2,0" FontSize="11" Opacity="0.8" />
          <ComboBox Style="{StaticResource Quill.CommandCombo}" Width="54" ItemsSource="{Binding ParagraphSpacingChoices}" SelectedItem="{Binding SpaceAfterPoints}" ToolTip="Space after paragraph (pt)" />
          <Border Style="{StaticResource Quill.CommandDivider}" />
          <ComboBox Style="{StaticResource Quill.CommandCombo}" Width="150"
                    ItemsSource="{Binding ParagraphStyles}" DisplayMemberPath="Name" SelectedItem="{Binding CurrentStyle}"
                    ToolTip="Paragraph style (Ctrl+Alt+1/2/3 headings, Ctrl+Shift+N normal)" />
          <Border Style="{StaticResource Quill.CommandDivider}" />
          <Button Style="{StaticResource Quill.CommandButton}" Content="&#x21B6;" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" ToolTip="Undo (Ctrl+Z)" />
          <Button Style="{StaticResource Quill.CommandButton}" Content="&#x21B7;" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" ToolTip="Redo (Ctrl+Y)" />
          <Border Style="{StaticResource Quill.CommandDivider}" />
          <Button Style="{StaticResource Quill.CommandButton}" Content="Find" Command="ApplicationCommands.Find" ToolTip="Find (Ctrl+F)" />
          <Button Style="{StaticResource Quill.CommandButton}" Content="Replace" Command="ApplicationCommands.Replace" ToolTip="Find and replace (Ctrl+H)" />
        </WrapPanel>
      </TabItem>

      <TabItem Header="Insert">
        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource Quill.CommandButton}" Content="Page Break" Command="{Binding InsertPageBreakCommand}" ToolTip="Insert a page break (Ctrl+Enter)" />
          <Button Style="{StaticResource Quill.CommandButton}" Content="Section Break" Command="{Binding InsertSectionBreakCommand}" ToolTip="Start a new section on the next page" />
          <Border Style="{StaticResource Quill.CommandDivider}" />
          <Button Style="{StaticResource Quill.CommandButton}" Content="Header" Click="OnEditHeader" ToolTip="Edit the header of the current page (or double-click the top margin)" />
          <Button Style="{StaticResource Quill.CommandButton}" Content="Footer" Click="OnEditFooter" ToolTip="Edit the footer of the current page (or double-click the bottom margin)" />
          <Button Style="{StaticResource Quill.CommandButton}" Content="Page Number" Click="OnInsertPageNumber" ToolTip="Insert a page number field; from the body it goes into the footer" />
          <Button Style="{StaticResource Quill.CommandButton}" Content="Page Count" Click="OnInsertPageCount" ToolTip="Insert the total number of pages" />
          <Border Style="{StaticResource Quill.CommandDivider}" />
          <Button Style="{StaticResource Quill.CommandButton}" Content="Symbol..." Click="OnInsertSymbol" ToolTip="Insert a special character" />
          <Button Style="{StaticResource Quill.CommandButton}" Content="Date &amp; Time..." Click="OnInsertDateTime" ToolTip="Insert the current date or time" />
          <Button Style="{StaticResource Quill.CommandButton}" Content="Picture..." Click="OnInsertPicture" ToolTip="Insert a picture from a file (you can also paste or drop one)" />
          <Button Style="{StaticResource Quill.CommandButton}" Content="Picture Size..." Click="OnPictureSize" ToolTip="Change the size of the selected picture" />
          <Border Style="{StaticResource Quill.CommandDivider}" />
          <Button Style="{StaticResource Quill.CommandButton}" Content="Close Header/Footer" Click="OnCloseHeaderFooter" ToolTip="Return to the document body (Esc)" />
        </StackPanel>
      </TabItem>

      <TabItem Header="Layout">
        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource Quill.CommandButton}" Content="Page Setup..." Click="OnPageSetup" ToolTip="Paper size, orientation, margins, headers and footers" />
          <Border Style="{StaticResource Quill.CommandDivider}" />
          <Button Style="{StaticResource Quill.CommandButton}" Content="Orientation" Command="{Binding ToggleOrientationCommand}" ToolTip="Switch between portrait and landscape" />
          <Border Style="{StaticResource Quill.CommandDivider}" />
          <TextBlock Text="Margins:" VerticalAlignment="Center" Margin="2,0,4,0" FontSize="13" />
          <Button Style="{StaticResource Quill.CommandButton}" Content="Normal" Command="{Binding SetMarginsCommand}" CommandParameter="Normal" />
          <Button Style="{StaticResource Quill.CommandButton}" Content="Narrow" Command="{Binding SetMarginsCommand}" CommandParameter="Narrow" />
          <Button Style="{StaticResource Quill.CommandButton}" Content="Moderate" Command="{Binding SetMarginsCommand}" CommandParameter="Moderate" />
        </StackPanel>
      </TabItem>

      <TabItem Header="View">
        <WrapPanel Orientation="Horizontal">
          <TextBlock Text="Zoom:" VerticalAlignment="Center" Margin="2,0,4,0" FontSize="13" />
          <Button Style="{StaticResource Quill.CommandButton}" Content="50%" Command="{Binding SetZoomCommand}" CommandParameter="50" />
          <Button Style="{StaticResource Quill.CommandButton}" Content="75%" Command="{Binding SetZoomCommand}" CommandParameter="75" />
          <Button Style="{StaticResource Quill.CommandButton}" Content="100%" Command="{Binding SetZoomCommand}" CommandParameter="100" />
          <Button Style="{StaticResource Quill.CommandButton}" Content="150%" Command="{Binding SetZoomCommand}" CommandParameter="150" />
          <Button Style="{StaticResource Quill.CommandButton}" Content="200%" Command="{Binding SetZoomCommand}" CommandParameter="200" />
          <Button Style="{StaticResource Quill.CommandButton}" Content="Fit Page" Click="OnFitPage" ToolTip="Zoom so a whole page fits" />
          <Button Style="{StaticResource Quill.CommandButton}" Content="Fit Width" Click="OnFitWidth" ToolTip="Zoom so the page fills the width" />
          <Border Style="{StaticResource Quill.CommandDivider}" />
          <ToggleButton Style="{StaticResource Quill.CommandToggle}" IsChecked="{Binding ShowFormattingMarks}" Content="&#xB6;" ToolTip="Show formatting marks (paragraphs, tabs, spaces, breaks)" />
          <Border Style="{StaticResource Quill.CommandDivider}" />
          <TextBlock Text="Theme:" VerticalAlignment="Center" Margin="2,0,4,0" FontSize="13" />
          <ComboBox Style="{StaticResource Quill.CommandCombo}" Width="90" ItemsSource="{Binding ThemeChoices}" SelectedItem="{Binding Theme}" ToolTip="Light, dark, or follow the Windows setting" />
          <Border Style="{StaticResource Quill.CommandDivider}" />
          <Button Style="{StaticResource Quill.CommandButton}" Content="Word Count" Click="OnWordCount" ToolTip="Words, characters, paragraphs, lines, pages (Ctrl+Shift+G)" />
          <Button Style="{StaticResource Quill.CommandButton}" Content="Go To Page..." Click="OnGoToPage" ToolTip="Jump to a page (Ctrl+G)" />
          <Border Style="{StaticResource Quill.CommandDivider}" />
          <Button Style="{StaticResource Quill.CommandButton}" Content="Select All" Click="OnSelectAll" ToolTip="Select all (Ctrl+A)" />
        </WrapPanel>
      </TabItem>

      <!-- Contextual tab: appears while a picture is selected, like Word's Picture Format. -->
      <TabItem x:Name="PictureTab" Header="Picture" Visibility="{Binding IsPictureSelected, Converter={StaticResource BoolToVis}}">
        <WrapPanel Orientation="Horizontal">
          <Button Style="{StaticResource Quill.CommandButton}" Content="Size..." Click="OnPictureSize" ToolTip="Exact width and height" />
          <Button Style="{StaticResource Quill.CommandButton}" Content="Original Size" Click="OnPictureOriginalSize" ToolTip="Back to the picture's own size" />
          <Button Style="{StaticResource Quill.CommandButton}" Content="Fit Width" Click="OnPictureFitWidth" ToolTip="As wide as the text column" />
          <Button Style="{StaticResource Quill.CommandButton}" Content="50%" Click="OnPictureScale" Tag="0.5" ToolTip="Half the current size" />
          <Button Style="{StaticResource Quill.CommandButton}" Content="200%" Click="OnPictureScale" Tag="2" ToolTip="Double the current size" />
          <Border Style="{StaticResource Quill.CommandDivider}" />
          <Button Style="{StaticResource Quill.CommandButton}" Content="Align Left" Command="{Binding AlignCommand}" CommandParameter="Left" ToolTip="Paragraph alignment" />
          <Button Style="{StaticResource Quill.CommandButton}" Content="Center" Command="{Binding AlignCommand}" CommandParameter="Center" ToolTip="Paragraph alignment" />
          <Button Style="{StaticResource Quill.CommandButton}" Content="Align Right" Command="{Binding AlignCommand}" CommandParameter="Right" ToolTip="Paragraph alignment" />
          <Border Style="{StaticResource Quill.CommandDivider}" />
          <Button Style="{StaticResource Quill.CommandButton}" Content="Replace..." Click="OnReplacePicture" ToolTip="Swap in another picture file at the same width" />
          <Button Style="{StaticResource Quill.CommandButton}" Content="Delete" Click="OnDeletePicture" />
        </WrapPanel>
      </TabItem>
    </TabControl>

    <StatusBar DockPanel.Dock="Bottom" Padding="6,0" FontSize="12">
      <StatusBarItem Padding="4,0">
        <TextBlock>
          <Run Text="Page " /><Run Text="{Binding CurrentPage, Mode=OneWay}" /><Run Text=" of " /><Run Text="{Binding PageCount, Mode=OneWay}" />
        </TextBlock>
      </StatusBarItem>
      <Separator />
      <StatusBarItem Padding="4,0">
        <TextBlock>
          <Run Text="{Binding WordCount, Mode=OneWay}" /><Run Text=" words" />
        </TextBlock>
      </StatusBarItem>
      <Separator />
      <StatusBarItem Padding="4,0">
        <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" MaxWidth="600" ToolTip="{Binding StatusMessage}" />
      </StatusBarItem>
      <StatusBarItem HorizontalAlignment="Right" Padding="4,0">
        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource Quill.StatusButton}" Content="&#x2212;" Command="{Binding ZoomOutCommand}" />
          <Slider Width="120" Minimum="0.1" Maximum="5" Value="{Binding Zoom}" VerticalAlignment="Center" Margin="6,0" />
          <Button Style="{StaticResource Quill.StatusButton}" Content="+" Command="{Binding ZoomInCommand}" />
          <TextBlock Width="44" TextAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,0">
            <Run Text="{Binding ZoomPercent, Mode=OneWay}" /><Run Text="%" />
          </TextBlock>
        </StackPanel>
      </StatusBarItem>
    </StatusBar>

    <ScrollViewer x:Name="Scroller"
                  CanContentScroll="True"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Visible"
                  PanningMode="Both"
                  Focusable="False">
      <views:DocumentView x:Name="Editor" Zoom="{Binding Zoom, Mode=TwoWay}" ShowFormattingMarks="{Binding ShowFormattingMarks, Mode=TwoWay}" />
    </ScrollViewer>
  </DockPanel>
</Window>
