<Window x:Class="Quill.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Quill.App.Views"
        xmlns:vm="clr-namespace:Quill.App.ViewModels"
        Title="{Binding Title}"
        Width="1200" Height="820" MinWidth="700" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
  <Window.DataContext>
    <vm:MainViewModel />
  </Window.DataContext>
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <!-- Right-click menu of the document; items with a Tag are shown or renamed in OnEditorMenuOpened. -->
    <ContextMenu x:Key="EditorMenu" Opened="OnEditorMenuOpened">
      <MenuItem Header="Cu_t" Click="OnCut" InputGestureText="Ctrl+X" />
      <MenuItem Header="_Copy" Click="OnCopy" InputGestureText="Ctrl+C" />
      <MenuItem Header="_Paste" Click="OnPaste" InputGestureText="Ctrl+V" />
      <MenuItem Header="Paste as plain te_xt" Click="OnPastePlainClick" InputGestureText="Ctrl+Alt+V" />
      <Separator />
      <MenuItem Header="_Font..." Click="OnFontDialog" InputGestureText="Ctrl+D" />
      <MenuItem Header="P_aragraph..." Click="OnParagraphDialog" />
      <MenuItem Header="_Bullets" IsCheckable="True" IsChecked="{Binding IsBulleted, Mode=TwoWay}" />
      <MenuItem Header="_Numbering" IsCheckable="True" IsChecked="{Binding IsNumbered, Mode=TwoWay}" />
      <MenuItem Tag="list" Header="L_ist">
        <MenuItem Header="_Restart Numbering at 1" Click="OnRestartNumbering" />
        <MenuItem Header="_Continue Previous List" Click="OnContinueNumbering" />
        <Separator />
        <MenuItem Header="Numbering  1. 2. 3." Click="OnListStyle" Tag="Decimal|%1." />
        <MenuItem Header="Numbering  1) 2) 3)" Click="OnListStyle" Tag="Decimal|%1)" />
        <MenuItem Header="Numbering  a. b. c." Click="OnListStyle" Tag="LowerLetter|%1." />
        <MenuItem Header="Numbering  a) b) c)" Click="OnListStyle" Tag="LowerLetter|%1)" />
        <MenuItem Header="Numbering  A. B. C." Click="OnListStyle" Tag="UpperLetter|%1." />
        <MenuItem Header="Numbering  i. ii. iii." Click="OnListStyle" Tag="LowerRoman|%1." />
        <MenuItem Header="Numbering  I. II. III." Click="OnListStyle" Tag="UpperRoman|%1." />
        <Separator />
        <MenuItem Header="Bullet  &#x2022;" Click="OnListStyle" Tag="Bullet|&#x2022;" />
        <MenuItem Header="Bullet  &#x25CB;" Click="OnListStyle" Tag="Bullet|&#x25CB;" />
        <MenuItem Header="Bullet  &#x25AA;" Click="OnListStyle" Tag="Bullet|&#x25AA;" />
        <MenuItem Header="Bullet  &#x2013;" Click="OnListStyle" Tag="Bullet|&#x2013;" />
        <MenuItem Header="Bullet  &#x2713;" Click="OnListStyle" Tag="Bullet|&#x2713;" />
        <MenuItem Header="Bullet  &#x27A2;" Click="OnListStyle" Tag="Bullet|&#x27A2;" />
      </MenuItem>
      <Separator />
      <MenuItem Tag="link" Header="_Link..." Click="OnInsertLink" InputGestureText="Ctrl+K" />
      <MenuItem Tag="open" Header="_Open Link" Click="OnOpenLink" InputGestureText="Ctrl+Click" />
      <MenuItem Tag="unlink" Header="_Remove Link" Click="OnRemoveLink" />
      <MenuItem Tag="comment" Header="New Co_mment" Click="OnInsertComment" InputGestureText="Ctrl+Alt+M" />
      <MenuItem Tag="picture" Header="Picture _Size..." Click="OnPictureSize" />
      <MenuItem Tag="table" Header="Insert Row _Below" Command="{Binding InsertRowBelowCommand}" />
      <MenuItem Tag="table" Header="Insert Column Ri_ght" Command="{Binding InsertColumnRightCommand}" />
      <MenuItem Tag="table" Header="Delete Ro_w" Command="{Binding DeleteRowCommand}" />
      <MenuItem Tag="table" Header="Delete Col_umn" Command="{Binding DeleteColumnCommand}" />
      <MenuItem Tag="table" Header="Delete _Table" Command="{Binding DeleteTableCommand}" />
      <Separator />
      <MenuItem Header="Select _All" Click="OnSelectAll" InputGestureText="Ctrl+A" />
    </ContextMenu>
  </Window.Resources>

  <Window.InputBindings>
    <KeyBinding Modifiers="Ctrl" Key="B" Command="{Binding ToggleBoldCommand}" />
    <KeyBinding Modifiers="Ctrl" Key="I" Command="{Binding ToggleItalicCommand}" />
    <KeyBinding Modifiers="Ctrl" Key="U" Command="{Binding ToggleUnderlineCommand}" />
    <KeyBinding Modifiers="Ctrl" Key="L" Command="{Binding AlignCommand}" CommandParameter="Left" />
    <KeyBinding Modifiers="Ctrl" Key="E" Command="{Binding AlignCommand}" CommandParameter="Center" />
    <KeyBinding Modifiers="Ctrl+Shift" Key="E" Command="{Binding ToggleTrackChangesCommand}" />
    <KeyBinding Modifiers="Ctrl" Key="R" Command="{Binding AlignCommand}" CommandParameter="Right" />
    <KeyBinding Modifiers="Ctrl" Key="J" Command="{Binding AlignCommand}" CommandParameter="Justify" />
    <KeyBinding Modifiers="Ctrl" Key="N" Command="{Binding NewDocumentCommand}" />
    <KeyBinding Modifiers="Ctrl" Key="O" Command="{Binding OpenCommand}" />
    <KeyBinding Modifiers="Ctrl" Key="S" Command="{Binding SaveCommand}" />
    <KeyBinding Key="F12" Command="{Binding SaveAsCommand}" />
    <KeyBinding Modifiers="Ctrl" Key="P" Command="{Binding PrintCommand}" />
    <KeyBinding Modifiers="Ctrl" Key="Z" Command="{Binding UndoCommand}" />
    <KeyBinding Modifiers="Ctrl" Key="Y" Command="{Binding RedoCommand}" />
    <KeyBinding Modifiers="Ctrl+Shift" Key="OemPeriod" Command="{Binding GrowFontCommand}" />
    <KeyBinding Modifiers="Ctrl+Shift" Key="OemComma" Command="{Binding ShrinkFontCommand}" />
    <KeyBinding Modifiers="Ctrl" Key="OemCloseBrackets" Command="{Binding NudgeFontCommand}" CommandParameter="1" />
    <KeyBinding Modifiers="Ctrl" Key="OemOpenBrackets" Command="{Binding NudgeFontCommand}" CommandParameter="-1" />
    <KeyBinding Modifiers="Ctrl+Shift" Key="OemPlus" Command="{Binding ToggleSuperscriptCommand}" />
    <KeyBinding Modifiers="Ctrl+Alt" Key="D1" Command="{Binding ApplyHeadingCommand}" CommandParameter="1" />
    <KeyBinding Modifiers="Ctrl+Alt" Key="D2" Command="{Binding ApplyHeadingCommand}" CommandParameter="2" />
    <KeyBinding Modifiers="Ctrl+Alt" Key="D3" Command="{Binding ApplyHeadingCommand}" CommandParameter="3" />
    <KeyBinding Modifiers="Ctrl+Shift" Key="N" Command="{Binding ApplyHeadingCommand}" CommandParameter="0" />
    <KeyBinding Modifiers="Ctrl" Key="D1" Command="{Binding SetLineSpacingCommand}" CommandParameter="1.0" />
    <KeyBinding Modifiers="Ctrl" Key="D2" Command="{Binding SetLineSpacingCommand}" CommandParameter="2.0" />
    <KeyBinding Modifiers="Ctrl" Key="D5" Command="{Binding SetLineSpacingCommand}" CommandParameter="1.5" />
    <KeyBinding Modifiers="Ctrl" Key="OemPlus" Command="{Binding ZoomInCommand}" />
    <KeyBinding Modifiers="Ctrl" Key="Add" Command="{Binding ZoomInCommand}" />
    <KeyBinding Modifiers="Ctrl" Key="OemMinus" Command="{Binding ZoomOutCommand}" />
    <KeyBinding Modifiers="Ctrl" Key="Subtract" Command="{Binding ZoomOutCommand}" />
    <KeyBinding Key="F3" Command="{x:Static views:MainWindow.FindNextCommand}" />
    <KeyBinding Key="F3" Modifiers="Shift" Command="{Binding CycleCaseCommand}" />
    <KeyBinding Key="F4" Modifiers="Shift" Command="{x:Static views:MainWindow.FindPreviousCommand}" />
    <KeyBinding Modifiers="Ctrl" Key="G" Command="{x:Static views:MainWindow.GoToPageCommand}" />
    <KeyBinding Modifiers="Ctrl+Shift" Key="G" Command="{x:Static views:MainWindow.WordCountCommand}" />
    <KeyBinding Key="F1" Command="{x:Static views:MainWindow.ShortcutsCommand}" />
    <KeyBinding Modifiers="Ctrl" Key="F1" Command="{x:Static views:MainWindow.ToggleRibbonCommand}" />
    <KeyBinding Modifiers="Ctrl+Shift" Key="C" Command="{Binding CopyFormatCommand}" />
    <KeyBinding Modifiers="Ctrl+Shift" Key="V" Command="{Binding PasteFormatCommand}" />
    <KeyBinding Modifiers="Ctrl+Alt" Key="V" Command="{x:Static views:MainWindow.PastePlainCommand}" />
    <KeyBinding Modifiers="Ctrl" Key="Space" Command="{Binding ClearFormattingCommand}" />
    <KeyBinding Modifiers="Ctrl+Shift" Key="D8" Command="{Binding ToggleFormattingMarksCommand}" />
    <KeyBinding Modifiers="Ctrl+Shift" Key="L" Command="{Binding ToggleBulletsCommand}" />
    <KeyBinding Modifiers="Ctrl" Key="M" Command="{Binding IncreaseIndentCommand}" />
    <KeyBinding Modifiers="Ctrl+Shift" Key="M" Command="{Binding DecreaseIndentCommand}" />
    <KeyBinding Modifiers="Ctrl" Key="Q" Command="{Binding ResetParagraphCommand}" />
    <KeyBinding Modifiers="Ctrl" Key="K" Command="{x:Static views:MainWindow.InsertLinkCommand}" />
    <KeyBinding Modifiers="Ctrl" Key="D" Command="{x:Static views:MainWindow.FontDialogCommand}" />
    <KeyBinding Modifiers="Ctrl+Alt" Key="F" Command="{Binding InsertFootnoteCommand}" />
    <KeyBinding Modifiers="Ctrl+Alt" Key="D" Command="{Binding InsertEndnoteCommand}" />
    <KeyBinding Modifiers="Ctrl+Alt" Key="M" Command="{x:Static views:MainWindow.InsertCommentCommand}" />
  </Window.InputBindings>
  <Window.CommandBindings>
    <CommandBinding Command="ApplicationCommands.Find" Executed="OnFind" />
    <CommandBinding Command="ApplicationCommands.Replace" Executed="OnReplace" />
    <CommandBinding Command="{x:Static views:MainWindow.FindNextCommand}" Executed="OnFindNext" />
    <CommandBinding Command="{x:Static views:MainWindow.FindPreviousCommand}" Executed="OnFindPrevious" />
    <CommandBinding Command="{x:Static views:MainWindow.GoToPageCommand}" Executed="OnGoToPageCommand" />
    <CommandBinding Command="{x:Static views:MainWindow.WordCountCommand}" Executed="OnWordCountCommand" />
    <CommandBinding Command="{x:Static views:MainWindow.ToggleRibbonCommand}" Executed="OnToggleRibbon" />
    <CommandBinding Command="{x:Static views:MainWindow.ShortcutsCommand}" Executed="OnShortcutsCommand" />
    <CommandBinding Command="{x:Static views:MainWindow.PastePlainCommand}" Executed="OnPastePlain" />
    <CommandBinding Command="{x:Static views:MainWindow.InsertLinkCommand}" Executed="OnInsertLinkCommand" />
    <CommandBinding Command="{x:Static views:MainWindow.FontDialogCommand}" Executed="OnFontDialogCommand" />
    <CommandBinding Command="{x:Static views:MainWindow.InsertCommentCommand}" Executed="OnInsertCommentCommand" />
  </Window.CommandBindings>

  <DockPanel>
    <!--
      The command bar follows Word's classic ribbon: tabs on top (File, Home, Insert, Layout, References, Review, View,
      plus the contextual Picture Format and Table Layout tabs); each tab shows groups named underneath, with large
      icon-and-label buttons for the main commands and rows of small ones for the rest.
    -->
    <Grid DockPanel.Dock="Top">
    <TabControl x:Name="Tabs" SelectedIndex="1" Margin="0" Padding="4,2" BorderThickness="0,0,0,1" SelectionChanged="OnTabChanged">
      <TabItem Header="File">
        <WrapPanel Orientation="Horizontal">
          <HeaderedContentControl Style="{StaticResource Quill.RibbonGroup}" Header="Document">
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#xE7C3;" Content="New" Command="{Binding NewDocumentCommand}" ToolTip="New document (Ctrl+N)" />
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#xE8E5;" Content="Open" Command="{Binding OpenCommand}" ToolTip="Open a .docx (Ctrl+O)" />
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#xE74E;" Content="Save" Command="{Binding SaveCommand}" ToolTip="Save (Ctrl+S)" />
              <StackPanel Style="{StaticResource Quill.RibbonStack}">
                <Button Style="{StaticResource Quill.StackButton}" Content="Save As..." Command="{Binding SaveAsCommand}" ToolTip="Save under a new name (F12)" />
                <Button Style="{StaticResource Quill.StackButton}" Content="New Window" Click="OnNewWindow" ToolTip="Open another Quill window (for a second document)" />
                <Button Style="{StaticResource Quill.StackButton}" Content="Properties..." Click="OnProperties" ToolTip="Title, author, subject and comments stored in the file" />
              </StackPanel>
            </StackPanel>
          </HeaderedContentControl>
          <HeaderedContentControl Style="{StaticResource Quill.RibbonGroup}" Header="Recent">
            <ComboBox Style="{StaticResource Quill.CommandCombo}" Width="220" ItemsSource="{Binding RecentFiles}" SelectedItem="{Binding SelectedRecent}" DisplayMemberPath="Name" ToolTip="Recently opened files" />
          </HeaderedContentControl>
          <HeaderedContentControl Style="{StaticResource Quill.RibbonGroup}" Header="Print and export">
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#xE749;" Content="Print" Command="{Binding PrintCommand}" ToolTip="Print (Ctrl+P)" />
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#xF56D;" Content="Print Preview" Click="OnPrintPreview" ToolTip="See the pages exactly as they will print" />
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#xEE71;" Content="Export PDF" Command="{Binding ExportPdfCommand}" ToolTip="Save the document as a PDF file" />
            </StackPanel>
          </HeaderedContentControl>
          <HeaderedContentControl Style="{StaticResource Quill.RibbonGroup}" Header="Quill">
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#xE713;" Content="Options" Click="OnOptions" ToolTip="Autosave, AutoCorrect, author name and measurement units" />
              <StackPanel Style="{StaticResource Quill.RibbonStack}">
                <Button Style="{StaticResource Quill.StackButton}" Content="Shortcuts" Click="OnShortcuts" ToolTip="Keyboard shortcuts (F1)" />
                <Button Style="{StaticResource Quill.StackButton}" Content="About" Click="OnAbout" />
                <Button Style="{StaticResource Quill.StackButton}" Content="Exit" Click="OnExit" />
              </StackPanel>
            </StackPanel>
          </HeaderedContentControl>
        </WrapPanel>
      </TabItem>

      <TabItem Header="Home">
        <WrapPanel Orientation="Horizontal">
          <HeaderedContentControl Style="{StaticResource Quill.RibbonGroup}" Header="Undo">
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#xE7A7;" Content="Undo" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" ToolTip="Undo (Ctrl+Z)" />
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#xE7A6;" Content="Redo" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" ToolTip="Redo (Ctrl+Y)" />
            </StackPanel>
          </HeaderedContentControl>
          <HeaderedContentControl Style="{StaticResource Quill.RibbonGroup}" Header="Clipboard">
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#xE77F;" Content="Paste" Click="OnPaste" ToolTip="Paste (Ctrl+V)" />
              <StackPanel Style="{StaticResource Quill.RibbonStack}">
                <Button Style="{StaticResource Quill.StackButton}" Click="OnCut" ToolTip="Cut (Ctrl+X)">
                  <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C6;" FontFamily="{StaticResource Quill.IconFont}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" /><TextBlock Text="Cut" /></StackPanel>
                </Button>
                <Button Style="{StaticResource Quill.StackButton}" Click="OnCopy" ToolTip="Copy (Ctrl+C)">
                  <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C8;" FontFamily="{StaticResource Quill.IconFont}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" /><TextBlock Text="Copy" /></StackPanel>
                </Button>
                <ToggleButton Style="{StaticResource Quill.StackToggle}" x:Name="PainterButton" IsChecked="{Binding IsFormatPainterActive}" MouseDoubleClick="OnPainterDoubleClick" ToolTip="Format Painter: copy the formatting here to the text you click or drag over next; double-click to keep it on (Ctrl+Shift+C / Ctrl+Shift+V)">
                  <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE790;" FontFamily="{StaticResource Quill.IconFont}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" /><TextBlock Text="Format Painter" /></StackPanel>
                </ToggleButton>
              </StackPanel>
            </StackPanel>
          </HeaderedContentControl>
          <HeaderedContentControl Style="{StaticResource Quill.RibbonGroup}" Header="Font">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <ComboBox Style="{StaticResource Quill.CommandCombo}" Width="150" IsEditable="True"
                          ItemsSource="{Binding FontFamilies}" Text="{Binding FontFamily, UpdateSourceTrigger=LostFocus}"
                          ToolTip="Font" />
                <ComboBox Style="{StaticResource Quill.CommandCombo}" Width="60"
                          ItemsSource="{Binding FontSizes}" SelectedItem="{Binding FontSize}"
                          ToolTip="Font size" />
                <Button Style="{StaticResource Quill.IconButton}" Content="&#xE8E8;" Command="{Binding GrowFontCommand}" ToolTip="Increase font size (Ctrl+Shift+&gt;)" />
                <Button Style="{StaticResource Quill.IconButton}" Content="&#xE8E7;" Command="{Binding ShrinkFontCommand}" ToolTip="Decrease font size (Ctrl+Shift+&lt;)" />
                <Button Style="{StaticResource Quill.CommandButton}" Content="Aa" Width="30" Padding="0" Click="OnCaseMenu" ToolTip="Change case (Shift+F3 cycles lowercase, UPPERCASE, Capitalize Each Word)">
                  <Button.ContextMenu>
                    <ContextMenu Closed="OnMenuClosed">
                      <MenuItem Header="Sentence case." Command="{Binding ChangeCaseCommand}" CommandParameter="Sentence" />
                      <MenuItem Header="lowercase" Command="{Binding ChangeCaseCommand}" CommandParameter="Lower" />
                      <MenuItem Header="UPPERCASE" Command="{Binding ChangeCaseCommand}" CommandParameter="Upper" />
                      <MenuItem Header="Capitalize Each Word" Command="{Binding ChangeCaseCommand}" CommandParameter="TitleCase" />
                      <MenuItem Header="tOGGLE cASE" Command="{Binding ChangeCaseCommand}" CommandParameter="Toggle" />
                    </ContextMenu>
                  </Button.ContextMenu>
                </Button>
                <Button Style="{StaticResource Quill.IconButton}" Content="&#xE75C;" Command="{Binding ClearFormattingCommand}" ToolTip="Clear all formatting (Ctrl+Space)" />
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <ToggleButton Style="{StaticResource Quill.IconToggle}" IsChecked="{Binding IsBold}" Content="&#xE8DD;" ToolTip="Bold (Ctrl+B)" />
                <ToggleButton Style="{StaticResource Quill.IconToggle}" IsChecked="{Binding IsItalic}" Content="&#xE8DB;" ToolTip="Italic (Ctrl+I)" />
                <ToggleButton Style="{StaticResource Quill.IconToggle}" IsChecked="{Binding IsUnderline}" Content="&#xE8DC;" ToolTip="Underline (Ctrl+U)" />
                <ToggleButton Style="{StaticResource Quill.IconToggle}" IsChecked="{Binding IsStrikethrough}" Content="&#xEDE0;" ToolTip="Strikethrough" />
                <ToggleButton Style="{StaticResource Quill.CommandToggle}" IsChecked="{Binding IsSubscript}" Content="x&#x2082;" Width="30" Padding="0" ToolTip="Subscript" />
                <ToggleButton Style="{StaticResource Quill.CommandToggle}" IsChecked="{Binding IsSuperscript}" Content="x&#xB2;" Width="30" Padding="0" ToolTip="Superscript (Ctrl+Shift+Plus)" />
                <Border Style="{StaticResource Quill.CommandDivider}" />
                <views:ColorPickerButton x:Name="HighlightPicker" IsHighlight="True" GlyphText="ab" ToggleToolTip="Text highlight color" CurrentColor="{Binding HighlightSwatch}" ColorSelected="OnHighlightSelected" />
                <views:ColorPickerButton x:Name="FontColorPicker" GlyphText="A" ToggleToolTip="Font color" CurrentColor="{Binding FontColor}" ColorSelected="OnFontColorSelected" />
                <Border Style="{StaticResource Quill.CommandDivider}" />
                <Button Style="{StaticResource Quill.CommandButton}" Content="Font..." Click="OnFontDialog" ToolTip="All character formatting in one dialog (Ctrl+D)" />
              </StackPanel>
            </StackPanel>
          </HeaderedContentControl>
          <HeaderedContentControl Style="{StaticResource Quill.RibbonGroup}" Header="Paragraph">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <ToggleButton Style="{StaticResource Quill.IconToggle}" IsChecked="{Binding IsBulleted}" Content="&#xE8FD;" ToolTip="Bullets" />
                <ToggleButton Style="{StaticResource Quill.CommandToggle}" IsChecked="{Binding IsNumbered}" Content="1." Width="30" Padding="0" ToolTip="Numbering" />
                <Button Style="{StaticResource Quill.CommandButton}" Content="&#x21E4;" Width="30" Padding="0" Command="{Binding DecreaseIndentCommand}" ToolTip="Decrease indent (Shift+Tab at the start of a list item)" />
                <Button Style="{StaticResource Quill.CommandButton}" Content="&#x21E5;" Width="30" Padding="0" Command="{Binding IncreaseIndentCommand}" ToolTip="Increase indent (Tab at the start of a list item)" />
                <Button Style="{StaticResource Quill.CommandButton}" Content="A&#x2193;Z" Width="34" Padding="0" Click="OnCaseMenu" ToolTip="Sort the selected paragraphs (or all of them) alphabetically or numerically">
                  <Button.ContextMenu>
                    <ContextMenu Closed="OnMenuClosed">
                      <MenuItem Header="Ascending (A to Z, 0 to 9)" Command="{Binding SortParagraphsCommand}" CommandParameter="Asc" />
                      <MenuItem Header="Descending (Z to A, 9 to 0)" Command="{Binding SortParagraphsCommand}" CommandParameter="Desc" />
                    </ContextMenu>
                  </Button.ContextMenu>
                </Button>

                <Border Style="{StaticResource Quill.CommandDivider}" />
                <ToggleButton Style="{StaticResource Quill.CommandToggle}" IsChecked="{Binding ShowFormattingMarks}" Content="&#xB6;" Width="30" Padding="0" ToolTip="Show formatting marks (paragraphs, tabs, spaces, breaks)" />
                <Border Style="{StaticResource Quill.CommandDivider}" />
                <TextBlock Text="Before" VerticalAlignment="Center" Margin="2,0,2,0" FontSize="11" Opacity="0.8" />
                <ComboBox Style="{StaticResource Quill.CommandCombo}" Width="54" ItemsSource="{Binding ParagraphSpacingChoices}" SelectedItem="{Binding SpaceBeforePoints}" ToolTip="Space before paragraph (pt)" />
                <TextBlock Text="After" VerticalAlignment="Center" Margin="6,0,2,0" FontSize="11" Opacity="0.8" />
                <ComboBox Style="{StaticResource Quill.CommandCombo}" Width="54" ItemsSource="{Binding ParagraphSpacingChoices}" SelectedItem="{Binding SpaceAfterPoints}" ToolTip="Space after paragraph (pt)" />
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <ToggleButton Style="{StaticResource Quill.IconToggle}" IsChecked="{Binding IsAlignLeft}" Content="&#xE8E4;" ToolTip="Align left (Ctrl+L)" />
                <ToggleButton Style="{StaticResource Quill.IconToggle}" IsChecked="{Binding IsAlignCenter}" Content="&#xE8E3;" ToolTip="Center (Ctrl+E)" />
                <ToggleButton Style="{StaticResource Quill.IconToggle}" IsChecked="{Binding IsAlignRight}" Content="&#xE8E2;" ToolTip="Align right (Ctrl+R)" />
                <ToggleButton Style="{StaticResource Quill.CommandToggle}" IsChecked="{Binding IsAlignJustify}" Content="&#x2261;" Width="30" Padding="0" ToolTip="Justify (Ctrl+J)" />
                <Border Style="{StaticResource Quill.CommandDivider}" />
                <views:ColorPickerButton x:Name="ParagraphShadingPicker" GlyphText="&#x25A6;" ToggleToolTip="Paragraph shading" CurrentColor="{Binding ParagraphShadingSwatch}" ColorSelected="OnParagraphShadingSelected" />
                <Button Style="{StaticResource Quill.CommandButton}" Content="&#x229E;" Width="30" Padding="0" Click="OnCaseMenu" ToolTip="Paragraph borders">
                  <Button.ContextMenu>
                    <ContextMenu Closed="OnMenuClosed">
                      <MenuItem Header="_Bottom Border" Command="{Binding SetParagraphBorderCommand}" CommandParameter="Bottom" />
                      <MenuItem Header="To_p Border" Command="{Binding SetParagraphBorderCommand}" CommandParameter="Top" />
                      <MenuItem Header="_Left Border" Command="{Binding SetParagraphBorderCommand}" CommandParameter="Left" />
                      <MenuItem Header="_Right Border" Command="{Binding SetParagraphBorderCommand}" CommandParameter="Right" />
                      <Separator />
                      <MenuItem Header="_Outside Borders" Command="{Binding SetParagraphBorderCommand}" CommandParameter="Box" />
                      <MenuItem Header="_No Border" Command="{Binding SetParagraphBorderCommand}" CommandParameter="None" />
                    </ContextMenu>
                  </Button.ContextMenu>
                </Button>

                <Border Style="{StaticResource Quill.CommandDivider}" />
                <TextBlock Text="&#x2195;" VerticalAlignment="Center" Margin="2,0" ToolTip="Line spacing" />
                <ComboBox Style="{StaticResource Quill.CommandCombo}" Width="62" ItemsSource="{Binding LineSpacingChoices}" SelectedItem="{Binding LineSpacingValue}" ToolTip="Line spacing (Ctrl+1, Ctrl+2, Ctrl+5)" />
                <Border Style="{StaticResource Quill.CommandDivider}" />
                <Button Style="{StaticResource Quill.CommandButton}" Content="Paragraph..." Click="OnParagraphDialog" ToolTip="Indents, spacing, line spacing and page-break options" />
              </StackPanel>
            </StackPanel>
          </HeaderedContentControl>
          <HeaderedContentControl Style="{StaticResource Quill.RibbonGroup}" Header="Styles">
            <StackPanel>
              <ComboBox Style="{StaticResource Quill.CommandCombo}" Width="170" Margin="1,0,1,4"
                        ItemsSource="{Binding ParagraphStyles}" DisplayMemberPath="Name" SelectedItem="{Binding CurrentStyle}"
                        ToolTip="Paragraph style (Ctrl+Alt+1/2/3 headings, Ctrl+Shift+N normal)" />
              <Button Style="{StaticResource Quill.CommandButton}" Content="Modify Style..." HorizontalAlignment="Stretch" Click="OnModifyStyle" ToolTip="Change the formatting of the current paragraph style for the whole document" />
            </StackPanel>
          </HeaderedContentControl>
          <HeaderedContentControl Style="{StaticResource Quill.RibbonGroup}" Header="Editing">
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#xE721;" Content="Find" Command="ApplicationCommands.Find" ToolTip="Find (Ctrl+F)" />
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#xE8AC;" Content="Replace" Command="ApplicationCommands.Replace" ToolTip="Find and replace (Ctrl+H)" />
              <StackPanel Style="{StaticResource Quill.RibbonStack}">
                <Button Style="{StaticResource Quill.StackButton}" Content="Select All" Click="OnSelectAll" ToolTip="Select all (Ctrl+A)" />
                <Button Style="{StaticResource Quill.StackButton}" Content="Go To Page..." Click="OnGoToPage" ToolTip="Jump to a page (Ctrl+G)" />
              </StackPanel>
            </StackPanel>
          </HeaderedContentControl>
        </WrapPanel>
      </TabItem>

      <TabItem Header="Insert">
        <WrapPanel Orientation="Horizontal">
          <HeaderedContentControl Style="{StaticResource Quill.RibbonGroup}" Header="Pages">
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#xE729;" Content="Cover Page" Command="{Binding InsertCoverPageCommand}" ToolTip="Add a title page (title, subtitle, author, date) at the front; it has no header or footer" />
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#xE7C3;" Content="Blank Page" Command="{Binding InsertBlankPageCommand}" ToolTip="Insert an empty page at the caret" />
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#xF56E;" Content="Page Break" Command="{Binding InsertPageBreakCommand}" ToolTip="Insert a page break (Ctrl+Enter)" />
            </StackPanel>
          </HeaderedContentControl>

          <HeaderedContentControl Style="{StaticResource Quill.RibbonGroup}" Header="Tables">
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#xF0E2;" Content="Table" Click="OnInsertTable" ToolTip="Insert a table with the given number of rows and columns" />
              <StackPanel Style="{StaticResource Quill.RibbonStack}">
                <Button Style="{StaticResource Quill.StackButton}" Content="Text to Table" Click="OnConvertTextToTable" ToolTip="Turn the selected paragraphs into a table: one row each, cells split at tabs (or commas)" />
              </StackPanel>
            </StackPanel>
          </HeaderedContentControl>

          <HeaderedContentControl Style="{StaticResource Quill.RibbonGroup}" Header="Illustrations">
            <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#xE8B9;" Content="Pictures" Click="OnInsertPicture" ToolTip="Insert a picture from a file (you can also paste or drop one)" />
          </HeaderedContentControl>
          <HeaderedContentControl Style="{StaticResource Quill.RibbonGroup}" Header="Links">
            <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#xE71B;" Content="Link" Click="OnInsertLink" ToolTip="Insert, edit or remove a hyperlink (Ctrl+K); Ctrl+Click a link to open it" />
          </HeaderedContentControl>
          <HeaderedContentControl Style="{StaticResource Quill.RibbonGroup}" Header="Comments">
            <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#xE90A;" Content="Comment" Click="OnInsertComment" ToolTip="Attach a comment to the selected text (Ctrl+Alt+M)" />
          </HeaderedContentControl>
          <HeaderedContentControl Style="{StaticResource Quill.RibbonGroup}" Header="Header &amp; Footer">
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#xF56E;" Content="Header" Click="OnEditHeader" ToolTip="Edit the header of the current page (or double-click the top margin)" />
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#xE7C3;" Content="Footer" Click="OnEditFooter" ToolTip="Edit the footer of the current page (or double-click the bottom margin)" />
              <StackPanel Style="{StaticResource Quill.RibbonStack}">
                <Button Style="{StaticResource Quill.StackButton}" Content="Page Number" Click="OnInsertPageNumber" ToolTip="Insert a page number field; from the body it goes into the footer" />
                <Button Style="{StaticResource Quill.StackButton}" Content="Page Count" Click="OnInsertPageCount" ToolTip="Insert the total number of pages" />
                <Button Style="{StaticResource Quill.StackButton}" Content="Close Header/Footer" Click="OnCloseHeaderFooter" ToolTip="Return to the document body (Esc)" />
              </StackPanel>
            </StackPanel>
          </HeaderedContentControl>
          <HeaderedContentControl Style="{StaticResource Quill.RibbonGroup}" Header="Text">
            <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#xE787;" Content="Date &amp; Time" Click="OnInsertDateTime" ToolTip="Insert the current date or time" />
          </HeaderedContentControl>
          <HeaderedContentControl Style="{StaticResource Quill.RibbonGroup}" Header="Symbols">
            <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#xF6BA;" Content="Symbol" Click="OnInsertSymbol" ToolTip="Insert a special character" />
          </HeaderedContentControl>
        </WrapPanel>
      </TabItem>

      <TabItem Header="Design">
        <WrapPanel Orientation="Horizontal">
          <HeaderedContentControl Style="{StaticResource Quill.RibbonGroup}" Header="Document Formatting">
            <StackPanel Orientation="Horizontal">
              <StackPanel>
                <ComboBox Style="{StaticResource Quill.CommandCombo}" Width="170" Margin="1,0,1,4"
                          ItemsSource="{Binding ParagraphStyles}" DisplayMemberPath="Name" SelectedItem="{Binding CurrentStyle}"
                          ToolTip="Paragraph style (Ctrl+Alt+1/2/3 headings, Ctrl+Shift+N normal)" />
                <Button Style="{StaticResource Quill.CommandButton}" Content="Modify Style..." HorizontalAlignment="Stretch" Click="OnModifyStyle" ToolTip="Change the formatting of the current paragraph style for the whole document" />
              </StackPanel>
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="1.1" Content="Number Headings" Command="{Binding ToggleHeadingNumbersCommand}" ToolTip="Number Heading 1-3 as 1, 1.1, 1.1.1 (click again to remove)" />
            </StackPanel>
          </HeaderedContentControl>
          <HeaderedContentControl Style="{StaticResource Quill.RibbonGroup}" Header="Page Background">
            <StackPanel Orientation="Horizontal">
              <StackPanel Style="{StaticResource Quill.RibbonStack}" Margin="4,0">
                <TextBlock Text="Page Color" FontSize="11" Opacity="0.8" Margin="2,0,0,2" HorizontalAlignment="Center" />
                <views:ColorPickerButton x:Name="PageColorPicker" GlyphText="&#x25A3;" ToggleToolTip="Page color (shown on screen, not printed, like Word)" CurrentColor="{Binding PageColorSwatch}" ColorSelected="OnPageColorSelected" HorizontalAlignment="Center" />
              </StackPanel>
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#xE7E6;" Content="Watermark" Click="OnCaseMenu" ToolTip="Diagonal text behind every page (DRAFT, CONFIDENTIAL...); shown on screen, in print and PDF, and kept in Word files">
                <Button.ContextMenu>
                  <ContextMenu Closed="OnMenuClosed">
                    <MenuItem Header="DRAFT" Command="{Binding SetWatermarkCommand}" CommandParameter="DRAFT" />
                    <MenuItem Header="CONFIDENTIAL" Command="{Binding SetWatermarkCommand}" CommandParameter="CONFIDENTIAL" />
                    <MenuItem Header="DO NOT COPY" Command="{Binding SetWatermarkCommand}" CommandParameter="DO NOT COPY" />
                    <MenuItem Header="SAMPLE" Command="{Binding SetWatermarkCommand}" CommandParameter="SAMPLE" />
                    <MenuItem Header="Custom Watermark..." Click="OnCustomWatermark" />
                    <Separator />
                    <MenuItem Header="Remove Watermark" Command="{Binding SetWatermarkCommand}" CommandParameter="" />
                  </ContextMenu>
                </Button.ContextMenu>
              </Button>
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#xE7C3;" Content="Page Borders" Click="OnPageBorders" ToolTip="A border around every page of the section or document: style, width, colour and distance" />

            </StackPanel>
          </HeaderedContentControl>
        </WrapPanel>
      </TabItem>

      <TabItem Header="Layout">

        <WrapPanel Orientation="Horizontal">
          <HeaderedContentControl Style="{StaticResource Quill.RibbonGroup}" Header="Page Setup">
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#xF574;" Content="Margins" Click="OnCaseMenu" ToolTip="Margin presets for this section">
                <Button.ContextMenu>
                  <ContextMenu Closed="OnMenuClosed">
                    <MenuItem Header="Normal (1 inch all round)" Command="{Binding SetMarginsCommand}" CommandParameter="Normal" />
                    <MenuItem Header="Narrow (0.5 inch)" Command="{Binding SetMarginsCommand}" CommandParameter="Narrow" />
                    <MenuItem Header="Moderate (1 inch top and bottom, 0.75 inch sides)" Command="{Binding SetMarginsCommand}" CommandParameter="Moderate" />
                    <Separator />
                    <MenuItem Header="Custom Margins..." Click="OnPageSetup" />
                  </ContextMenu>
                </Button.ContextMenu>
              </Button>
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#xE8B4;" Content="Orientation" Command="{Binding ToggleOrientationCommand}" ToolTip="Switch between portrait and landscape" />
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#xF740;" Content="Columns" Click="OnCaseMenu" ToolTip="Text columns for this section">
                <Button.ContextMenu>
                  <ContextMenu Closed="OnMenuClosed">
                    <MenuItem Header="One" Command="{Binding SetColumnsCommand}" CommandParameter="1" />
                    <MenuItem Header="Two" Command="{Binding SetColumnsCommand}" CommandParameter="2" />
                    <MenuItem Header="Three" Command="{Binding SetColumnsCommand}" CommandParameter="3" />
                  </ContextMenu>
                </Button.ContextMenu>
              </Button>
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#xF56E;" Content="Breaks" Click="OnCaseMenu" ToolTip="Page, column and section breaks">
                <Button.ContextMenu>
                  <ContextMenu Closed="OnMenuClosed">
                    <MenuItem Header="Page Break" Command="{Binding InsertPageBreakCommand}" InputGestureText="Ctrl+Enter" />
                    <MenuItem Header="Column Break" Command="{Binding InsertColumnBreakCommand}" InputGestureText="Ctrl+Shift+Enter" />
                    <Separator />
                    <MenuItem Header="Section Break (Next Page)" Command="{Binding InsertSectionBreakCommand}" />
                  </ContextMenu>
                </Button.ContextMenu>
              </Button>
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#xE713;" Content="Page Setup" Click="OnPageSetup" ToolTip="Paper size, orientation, margins, headers and footers" />
            </StackPanel>
          </HeaderedContentControl>
        </WrapPanel>
      </TabItem>

      <TabItem Header="References">
        <WrapPanel Orientation="Horizontal">
          <HeaderedContentControl Style="{StaticResource Quill.RibbonGroup}" Header="Table of Contents">
            <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#xF0E3;" Content="Table of Contents" Click="OnInsertToc" ToolTip="Insert (or refresh) a table of contents built from the Heading 1-3 paragraphs" />
          </HeaderedContentControl>
          <HeaderedContentControl Style="{StaticResource Quill.RibbonGroup}" Header="Footnotes">
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#xB9;" Content="Insert Footnote" Command="{Binding InsertFootnoteCommand}" ToolTip="Insert a footnote at the caret (Ctrl+Alt+F); Esc returns from the note to the text" />
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#x2071;" Content="Insert Endnote" Command="{Binding InsertEndnoteCommand}" ToolTip="Insert an endnote (Ctrl+Alt+D); the notes collect at the end of the document" />
            </StackPanel>
          </HeaderedContentControl>
          <HeaderedContentControl Style="{StaticResource Quill.RibbonGroup}" Header="Captions">
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#xE8BA;" Content="Insert Caption" Click="OnInsertCaption" ToolTip="Add a numbered caption (Figure 1, Table 2...) below a picture or above a table; numbers follow the order in the document" />
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#xF0E3;" Content="Table of Figures" Click="OnCaseMenu" ToolTip="Insert (or refresh) a list of the captions of one series with their page numbers">
                <Button.ContextMenu>
                  <ContextMenu Closed="OnMenuClosed">
                    <MenuItem Header="Table of Figures" Tag="Figure" Click="OnInsertTableOfFigures" />
                    <MenuItem Header="Table of Tables" Tag="Table" Click="OnInsertTableOfFigures" />
                    <MenuItem Header="Table of Equations" Tag="Equation" Click="OnInsertTableOfFigures" />
                  </ContextMenu>
                </Button.ContextMenu>
              </Button>
            </StackPanel>
          </HeaderedContentControl>

          <HeaderedContentControl Style="{StaticResource Quill.RibbonGroup}" Header="Headings">

            <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="1.1" Content="Number Headings" Command="{Binding ToggleHeadingNumbersCommand}" ToolTip="Number Heading 1-3 as 1, 1.1, 1.1.1 (click again to remove)" />
          </HeaderedContentControl>
        </WrapPanel>
      </TabItem>

      <TabItem Header="Review">
        <WrapPanel Orientation="Horizontal">
          <HeaderedContentControl Style="{StaticResource Quill.RibbonGroup}" Header="Proofing">
            <StackPanel Orientation="Horizontal">
              <ToggleButton Style="{StaticResource Quill.RibbonToggle}" views:Ribbon.Icon="&#xE82D;" Content="Spelling" IsChecked="{Binding CheckSpelling}" ToolTip="Underline words the Windows spell checker does not know; right-click a word for suggestions" />
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#xE8C1;" Content="Word Count" Command="{x:Static views:MainWindow.WordCountCommand}" ToolTip="Pages, words, characters, paragraphs (Ctrl+Shift+G)" />
            </StackPanel>
          </HeaderedContentControl>
          <HeaderedContentControl Style="{StaticResource Quill.RibbonGroup}" Header="Comments">
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#xE90A;" Content="New Comment" Click="OnInsertComment" ToolTip="Attach a comment to the selected text (Ctrl+Alt+M)" />
              <ToggleButton Style="{StaticResource Quill.RibbonToggle}" views:Ribbon.Icon="&#xF0E3;" Content="Show Comments" IsChecked="{Binding ShowComments}" ToolTip="Show the comments pane" />
            </StackPanel>
          </HeaderedContentControl>
          <HeaderedContentControl Style="{StaticResource Quill.RibbonGroup}" Header="Tracking">
            <ToggleButton Style="{StaticResource Quill.RibbonToggle}" views:Ribbon.Icon="&#xEF60;" Content="Track Changes" IsChecked="{Binding TrackChanges}" ToolTip="Record insertions and deletions as tracked changes (Ctrl+Shift+E); insertions are underlined and deletions struck through in the author's colour" />
          </HeaderedContentControl>
          <HeaderedContentControl Style="{StaticResource Quill.RibbonGroup}" Header="Changes">
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#xE8FB;" Content="Accept" Command="{Binding AcceptChangeCommand}" ToolTip="Accept the selected change (or the one at the caret) and move to the next" />
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#xE711;" Content="Reject" Command="{Binding RejectChangeCommand}" ToolTip="Reject the selected change (or the one at the caret) and move to the next" />
              <StackPanel Style="{StaticResource Quill.RibbonStack}">
                <Button Style="{StaticResource Quill.StackButton}" Content="Previous Change" Command="{Binding PreviousChangeCommand}" ToolTip="Select the previous tracked change" />
                <Button Style="{StaticResource Quill.StackButton}" Content="Next Change" Command="{Binding NextChangeCommand}" ToolTip="Select the next tracked change" />
              </StackPanel>
              <StackPanel Style="{StaticResource Quill.RibbonStack}">
                <Button Style="{StaticResource Quill.StackButton}" Content="Accept All" Command="{Binding AcceptAllChangesCommand}" ToolTip="Keep every insertion and remove every deletion" />
                <Button Style="{StaticResource Quill.StackButton}" Content="Reject All" Command="{Binding RejectAllChangesCommand}" ToolTip="Remove every insertion and restore every deletion" />
              </StackPanel>
            </StackPanel>
          </HeaderedContentControl>
        </WrapPanel>
      </TabItem>

      <TabItem Header="View">
        <WrapPanel Orientation="Horizontal">
          <HeaderedContentControl Style="{StaticResource Quill.RibbonGroup}" Header="Show">
            <StackPanel Orientation="Horizontal">
              <ToggleButton Style="{StaticResource Quill.RibbonToggle}" views:Ribbon.Icon="&#xED5E;" Content="Ruler" IsChecked="{Binding ShowRuler}" ToolTip="Show the ruler: drag the markers for indents, click to add a tab stop, drag a tab stop off to remove it" />
              <ToggleButton Style="{StaticResource Quill.RibbonToggle}" views:Ribbon.Icon="&#xE700;" Content="Navigation Pane" IsChecked="{Binding ShowNavigation}" ToolTip="Show the headings of the document in a side pane; click one to jump there" />
              <ToggleButton Style="{StaticResource Quill.RibbonToggle}" views:Ribbon.Icon="&#xE90A;" Content="Comments Pane" IsChecked="{Binding ShowComments}" ToolTip="Show the comments pane" />
            </StackPanel>
          </HeaderedContentControl>
          <HeaderedContentControl Style="{StaticResource Quill.RibbonGroup}" Header="Zoom">
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#xE71E;" Content="100%" Command="{Binding SetZoomCommand}" CommandParameter="100" ToolTip="Zoom to 100%" />
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#xE7C3;" Content="One Page" Click="OnFitPage" ToolTip="Zoom so a whole page fits" />
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#xF56E;" Content="Page Width" Click="OnFitWidth" ToolTip="Zoom so the page fills the width" />
              <StackPanel Style="{StaticResource Quill.RibbonStack}">
                <Button Style="{StaticResource Quill.StackButton}" Content="50%" Command="{Binding SetZoomCommand}" CommandParameter="50" />
                <Button Style="{StaticResource Quill.StackButton}" Content="75%" Command="{Binding SetZoomCommand}" CommandParameter="75" />
                <Button Style="{StaticResource Quill.StackButton}" Content="150%" Command="{Binding SetZoomCommand}" CommandParameter="150" />
              </StackPanel>
              <StackPanel Style="{StaticResource Quill.RibbonStack}">
                <Button Style="{StaticResource Quill.StackButton}" Content="200%" Command="{Binding SetZoomCommand}" CommandParameter="200" />
                <Button Style="{StaticResource Quill.StackButton}" Content="Go To Page..." Click="OnGoToPage" ToolTip="Jump to a page (Ctrl+G)" />
              </StackPanel>
            </StackPanel>
          </HeaderedContentControl>
          <HeaderedContentControl Style="{StaticResource Quill.RibbonGroup}" Header="Window">
            <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#xE710;" Content="New Window" Click="OnNewWindow" ToolTip="Open another Quill window (for a second document)" />
          </HeaderedContentControl>
          <HeaderedContentControl Style="{StaticResource Quill.RibbonGroup}" Header="Appearance">
            <StackPanel>
              <TextBlock Text="Theme" FontSize="11" Opacity="0.8" Margin="2,0,0,2" />
              <ComboBox Style="{StaticResource Quill.CommandCombo}" Width="110" ItemsSource="{Binding ThemeChoices}" SelectedItem="{Binding Theme}" ToolTip="Light, dark, or follow the Windows setting" />
            </StackPanel>
          </HeaderedContentControl>
        </WrapPanel>
      </TabItem>

      <!-- Contextual tab: appears while a picture is selected, like Word's Picture Format. -->
      <TabItem x:Name="PictureTab" Header="Picture Format" Visibility="{Binding IsPictureSelected, Converter={StaticResource BoolToVis}}">
        <WrapPanel Orientation="Horizontal">
          <HeaderedContentControl Style="{StaticResource Quill.RibbonGroup}" Header="Adjust">
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#xE8B9;" Content="Replace" Click="OnReplacePicture" ToolTip="Swap in another picture file at the same width" />
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#xE74D;" Content="Delete" Click="OnDeletePicture" ToolTip="Remove the picture" />
            </StackPanel>
          </HeaderedContentControl>
          <HeaderedContentControl Style="{StaticResource Quill.RibbonGroup}" Header="Arrange">
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource Quill.IconButton}" Content="&#xE8E4;" Command="{Binding AlignCommand}" CommandParameter="Left" ToolTip="Align left" />
              <Button Style="{StaticResource Quill.IconButton}" Content="&#xE8E3;" Command="{Binding AlignCommand}" CommandParameter="Center" ToolTip="Center" />
              <Button Style="{StaticResource Quill.IconButton}" Content="&#xE8E2;" Command="{Binding AlignCommand}" CommandParameter="Right" ToolTip="Align right" />
            </StackPanel>
          </HeaderedContentControl>
          <HeaderedContentControl Style="{StaticResource Quill.RibbonGroup}" Header="Size">
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#xE740;" Content="Size" Click="OnPictureSize" ToolTip="Exact width and height" />
              <StackPanel Style="{StaticResource Quill.RibbonStack}">
                <Button Style="{StaticResource Quill.StackButton}" Content="Original Size" Click="OnPictureOriginalSize" ToolTip="Back to the picture's own size" />
                <Button Style="{StaticResource Quill.StackButton}" Content="Fit Width" Click="OnPictureFitWidth" ToolTip="As wide as the text column" />
              </StackPanel>
              <StackPanel Style="{StaticResource Quill.RibbonStack}">
                <Button Style="{StaticResource Quill.StackButton}" Content="50%" Click="OnPictureScale" Tag="0.5" ToolTip="Half the current size" />
                <Button Style="{StaticResource Quill.StackButton}" Content="200%" Click="OnPictureScale" Tag="2" ToolTip="Double the current size" />
              </StackPanel>
            </StackPanel>
          </HeaderedContentControl>
        </WrapPanel>
      </TabItem>

      <!-- Contextual tab: appears while the caret is inside a table, like Word's Table Layout. -->
      <TabItem x:Name="TableTab" Header="Table Layout" Visibility="{Binding IsInTable, Converter={StaticResource BoolToVis}}">
        <WrapPanel Orientation="Horizontal">
          <HeaderedContentControl Style="{StaticResource Quill.RibbonGroup}" Header="Rows &amp; Columns">
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#xE74D;" Content="Delete" Click="OnCaseMenu" ToolTip="Delete the row, column or table at the caret">
                <Button.ContextMenu>
                  <ContextMenu Closed="OnMenuClosed">
                    <MenuItem Header="Delete Row" Command="{Binding DeleteRowCommand}" />
                    <MenuItem Header="Delete Column" Command="{Binding DeleteColumnCommand}" />
                    <MenuItem Header="Delete Table" Command="{Binding DeleteTableCommand}" />
                  </ContextMenu>
                </Button.ContextMenu>
              </Button>
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#x2191;" Content="Insert Above" Command="{Binding InsertRowAboveCommand}" ToolTip="Insert a row above the current one" />
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#x2193;" Content="Insert Below" Command="{Binding InsertRowBelowCommand}" ToolTip="Insert a row below the current one (Tab in the last cell does the same)" />
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#x2190;" Content="Insert Left" Command="{Binding InsertColumnLeftCommand}" ToolTip="Insert a column to the left of the current cell" />
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#x2192;" Content="Insert Right" Command="{Binding InsertColumnRightCommand}" ToolTip="Insert a column to the right of the current cell" />
            </StackPanel>
          </HeaderedContentControl>
          <HeaderedContentControl Style="{StaticResource Quill.RibbonGroup}" Header="Merge">
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#x21E5;" Content="Merge Right" Command="{Binding MergeCellRightCommand}" ToolTip="Join this cell with the one to its right" />
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#x21E9;" Content="Merge Down" Command="{Binding MergeCellDownCommand}" ToolTip="Join this cell with the one beneath it" />
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#xF740;" Content="Split Cell" Command="{Binding SplitCellCommand}" ToolTip="Undo a merge: one cell per column, or one per row" />
            </StackPanel>
          </HeaderedContentControl>
          <HeaderedContentControl Style="{StaticResource Quill.RibbonGroup}" Header="Table Styles">
            <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#xF207;" Content="Table Styles" Click="OnCaseMenu" ToolTip="Apply a built-in look: borders, a coloured bold header row and banded rows">
              <Button.ContextMenu>
                <ContextMenu Closed="OnMenuClosed">
                  <MenuItem Header="Plain Table" Command="{Binding ApplyTableStyleCommand}" CommandParameter="Plain Table" />
                  <MenuItem Header="Table Grid" Command="{Binding ApplyTableStyleCommand}" CommandParameter="Table Grid" />
                  <MenuItem Header="Grid Table Light (bold header)" Command="{Binding ApplyTableStyleCommand}" CommandParameter="Grid Table Light" />
                  <Separator />
                  <MenuItem Header="Grid Table Blue" Command="{Binding ApplyTableStyleCommand}" CommandParameter="Grid Table Blue" />
                  <MenuItem Header="Grid Table Orange" Command="{Binding ApplyTableStyleCommand}" CommandParameter="Grid Table Orange" />
                  <MenuItem Header="Grid Table Green" Command="{Binding ApplyTableStyleCommand}" CommandParameter="Grid Table Green" />
                  <MenuItem Header="Grid Table Gray" Command="{Binding ApplyTableStyleCommand}" CommandParameter="Grid Table Gray" />
                  <MenuItem Header="List Table Blue (no borders)" Command="{Binding ApplyTableStyleCommand}" CommandParameter="List Table Blue" />
                </ContextMenu>
              </Button.ContextMenu>
            </Button>
          </HeaderedContentControl>
          <HeaderedContentControl Style="{StaticResource Quill.RibbonGroup}" Header="Borders and Shading">

            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#xF0E2;" Content="Borders" Command="{Binding ToggleTableBordersCommand}" ToolTip="Show or hide the grid lines" />
              <ToggleButton Style="{StaticResource Quill.RibbonToggle}" views:Ribbon.Icon="&#xE8E9;" Content="Header Row" IsChecked="{Binding IsHeaderRow}" ToolTip="Repeat this row at the top of every page the table continues on" />
              <StackPanel Style="{StaticResource Quill.RibbonStack}">
                <TextBlock Text="Shading" FontSize="11" Opacity="0.8" Margin="2,0,0,2" />
                <views:ColorPickerButton x:Name="ShadingPicker" GlyphText="&#x25A4;" ToggleToolTip="Cell shading" CurrentColor="{Binding CellShadingSwatch}" ColorSelected="OnCellShadingSelected" />
              </StackPanel>
            </StackPanel>
          </HeaderedContentControl>
          <HeaderedContentControl Style="{StaticResource Quill.RibbonGroup}" Header="Cell Size">
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#x21D4;" Content="Distribute Columns" Command="{Binding DistributeColumnsCommand}" ToolTip="Make every column the same width (the table keeps its width)" />
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#x2194;" Content="AutoFit Window" Click="OnAutoFitTable" ToolTip="Stretch the columns in proportion so the table fills the text column" />
            </StackPanel>
          </HeaderedContentControl>
          <HeaderedContentControl Style="{StaticResource Quill.RibbonGroup}" Header="Alignment">
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource Quill.IconButton}" Content="&#xE8E4;" Command="{Binding AlignCommand}" CommandParameter="Left" ToolTip="Align cell text left" />
              <Button Style="{StaticResource Quill.IconButton}" Content="&#xE8E3;" Command="{Binding AlignCommand}" CommandParameter="Center" ToolTip="Center cell text" />
              <Button Style="{StaticResource Quill.IconButton}" Content="&#xE8E2;" Command="{Binding AlignCommand}" CommandParameter="Right" ToolTip="Align cell text right" />
              <Border Style="{StaticResource Quill.CommandDivider}" />
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#xF0E2;" Content="Table Position" Click="OnCaseMenu" ToolTip="Where a table narrower than the text column sits">
                <Button.ContextMenu>
                  <ContextMenu Closed="OnMenuClosed">
                    <MenuItem Header="Align Table Left" Command="{Binding SetTableAlignmentCommand}" CommandParameter="Left" />
                    <MenuItem Header="Center Table" Command="{Binding SetTableAlignmentCommand}" CommandParameter="Center" />
                    <MenuItem Header="Align Table Right" Command="{Binding SetTableAlignmentCommand}" CommandParameter="Right" />
                  </ContextMenu>
                </Button.ContextMenu>
              </Button>
            </StackPanel>
          </HeaderedContentControl>
          <HeaderedContentControl Style="{StaticResource Quill.RibbonGroup}" Header="Data">
            <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#xE8D2;" Content="Convert to Text" Command="{Binding ConvertTableToTextCommand}" ToolTip="Replace the table with one paragraph per row, cells separated by tabs" />
          </HeaderedContentControl>

        </WrapPanel>
      </TabItem>
      <!-- Contextual tab: appears while a header or footer is being edited, like Word's Header & Footer tab. -->
      <TabItem x:Name="HeaderFooterTab" Header="Header &amp; Footer" Visibility="{Binding IsInHeaderFooter, Converter={StaticResource BoolToVis}}">
        <WrapPanel Orientation="Horizontal">
          <HeaderedContentControl Style="{StaticResource Quill.RibbonGroup}" Header="Header &amp; Footer">
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#xF56E;" Content="Header" Click="OnEditHeader" ToolTip="Edit the header of this page" />
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#xE7C3;" Content="Footer" Click="OnEditFooter" ToolTip="Edit the footer of this page" />
            </StackPanel>
          </HeaderedContentControl>
          <HeaderedContentControl Style="{StaticResource Quill.RibbonGroup}" Header="Insert">
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="#" Content="Page Number" Click="OnInsertPageNumber" ToolTip="Insert the page number field" />
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#x2211;" Content="Page Count" Click="OnInsertPageCount" ToolTip="Insert the total number of pages" />
              <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#xE787;" Content="Date &amp; Time" Click="OnInsertDateTime" ToolTip="Insert the current date or time" />
            </StackPanel>
          </HeaderedContentControl>
          <HeaderedContentControl Style="{StaticResource Quill.RibbonGroup}" Header="Navigation">
            <ToggleButton Style="{StaticResource Quill.RibbonToggle}" views:Ribbon.Icon="&#xE71B;" Content="Link to Previous" IsChecked="{Binding IsLinkedToPrevious}" IsEnabled="{Binding CanLinkToPrevious}" ToolTip="Use the previous section's header or footer here; switch off to give this section its own copy" />
          </HeaderedContentControl>
          <HeaderedContentControl Style="{StaticResource Quill.RibbonGroup}" Header="Options">
            <StackPanel Style="{StaticResource Quill.RibbonStack}">
              <ToggleButton Style="{StaticResource Quill.StackToggle}" Content="Different First Page" IsChecked="{Binding DifferentFirstPage}" ToolTip="The first page of this section gets its own header and footer" />
              <ToggleButton Style="{StaticResource Quill.StackToggle}" Content="Different Odd &amp; Even Pages" IsChecked="{Binding DifferentOddEven}" ToolTip="Even pages get their own header and footer (whole document)" />
            </StackPanel>
          </HeaderedContentControl>
          <HeaderedContentControl Style="{StaticResource Quill.RibbonGroup}" Header="Close">
            <Button Style="{StaticResource Quill.RibbonButton}" views:Ribbon.Icon="&#xE711;" Content="Close Header and Footer" Click="OnCloseHeaderFooter" ToolTip="Return to the document body (Esc)" />
          </HeaderedContentControl>
        </WrapPanel>
      </TabItem>
    </TabControl>
    <ToggleButton Style="{StaticResource Quill.IconToggle}" IsChecked="{Binding IsRibbonCollapsed}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,8,0" Height="24" Width="26"
                  ToolTip="Collapse the ribbon to its tabs; click a tab to use it (Ctrl+F1)" AutomationProperties.Name="Collapse the ribbon">
      <TextBlock Text="&#xE70E;" FontFamily="{StaticResource Quill.IconFont}" FontSize="11" />
    </ToggleButton>
    </Grid>

    <StatusBar DockPanel.Dock="Bottom" Padding="6,0" FontSize="12">
      <StatusBarItem Padding="4,0">
        <TextBlock>
          <Run Text="Page " /><Run Text="{Binding CurrentPage, Mode=OneWay}" /><Run Text=" of " /><Run Text="{Binding PageCount, Mode=OneWay}" />
        </TextBlock>
      </StatusBarItem>
      <Separator />
      <StatusBarItem Padding="4,0">
        <TextBlock>
          <Run Text="{Binding WordCountText, Mode=OneWay}" />
        </TextBlock>
      </StatusBarItem>
      <Separator Visibility="{Binding TrackChanges, Converter={StaticResource BoolToVis}}" />
      <StatusBarItem Padding="4,0" Visibility="{Binding TrackChanges, Converter={StaticResource BoolToVis}}">
        <TextBlock Text="Track Changes" ToolTip="Edits are being recorded as tracked changes (Review tab, Ctrl+Shift+E)" />
      </StatusBarItem>
      <Separator Visibility="{Binding IsOvertype, Converter={StaticResource BoolToVis}}" />
      <StatusBarItem Padding="4,0" Visibility="{Binding IsOvertype, Converter={StaticResource BoolToVis}}">
        <TextBlock Text="Overtype" ToolTip="Typing replaces the characters after the caret; press Insert to return to inserting" />
      </StatusBarItem>


      <Separator />
      <StatusBarItem Padding="4,0">
        <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" MaxWidth="600" ToolTip="{Binding StatusMessage}" />
      </StatusBarItem>
      <StatusBarItem HorizontalAlignment="Right" Padding="4,0">
        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource Quill.StatusButton}" Content="&#x2212;" Command="{Binding ZoomOutCommand}" />
          <Slider Width="120" Minimum="0.1" Maximum="5" Value="{Binding Zoom}" VerticalAlignment="Center" Margin="6,0" />
          <Button Style="{StaticResource Quill.StatusButton}" Content="+" Command="{Binding ZoomInCommand}" />
          <TextBlock Width="44" TextAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,0">
            <Run Text="{Binding ZoomPercent, Mode=OneWay}" /><Run Text="%" />
          </TextBlock>
        </StackPanel>
      </StatusBarItem>
    </StatusBar>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <!-- Navigation pane: headings of the document; click one to jump there. -->
      <Border Grid.Column="0" Width="240" BorderThickness="0,0,1,0" BorderBrush="{StaticResource Quill.DividerBrush}"
              Visibility="{Binding ShowNavigation, Converter={StaticResource BoolToVis}}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Navigation" FontWeight="SemiBold" Margin="10,8,10,4" />
          <TextBlock DockPanel.Dock="Top" Text="Headings appear here as you use the Heading 1-3 styles." Margin="10,0,10,8" Opacity="0.7" TextWrapping="Wrap"
                     Visibility="{Binding HasNoHeadings, Converter={StaticResource BoolToVis}}" />
          <ListBox x:Name="NavList" ItemsSource="{Binding Headings}" SelectedItem="{Binding CurrentHeading, Mode=TwoWay}"
                   BorderThickness="0" Background="Transparent" SelectionChanged="OnHeadingSelected"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Display}" Margin="{Binding Margin}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <views:RulerView x:Name="Ruler" Grid.Row="0" Grid.Column="1" Visibility="{Binding ShowRuler, Converter={StaticResource BoolToVis}}" />
        <views:VerticalRulerView x:Name="VerticalRuler" Grid.Row="1" Grid.Column="0" Visibility="{Binding ShowRuler, Converter={StaticResource BoolToVis}}" />
      <ScrollViewer x:Name="Scroller" Grid.Row="1" Grid.Column="1"
                  CanContentScroll="True"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Visible"
                  PanningMode="Both"
                  Focusable="False"
                  ScrollChanged="OnScrollChanged">
      <views:DocumentView x:Name="Editor" Zoom="{Binding Zoom, Mode=TwoWay}" ShowFormattingMarks="{Binding ShowFormattingMarks, Mode=TwoWay}" Overtype="{Binding IsOvertype, Mode=TwoWay}" ContextMenu="{StaticResource EditorMenu}" CheckSpelling="{Binding CheckSpelling}" />
    </ScrollViewer>
        <!-- Word's mini toolbar: appears beside a fresh mouse selection with the most used formatting. -->
        <Popup x:Name="MiniToolbar" PlacementTarget="{Binding ElementName=Editor}" Placement="Relative" StaysOpen="True" AllowsTransparency="True" Focusable="False">
          <Border Background="{DynamicResource Quill.FlyoutBackground}" BorderBrush="{DynamicResource Quill.FlyoutBorder}" BorderThickness="1" CornerRadius="6" Padding="4" Margin="4,2,8,10"
                  TextElement.Foreground="{DynamicResource Quill.FlyoutForeground}">
            <Border.Effect>
              <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
              <ComboBox Style="{StaticResource Quill.CommandCombo}" Width="130" IsEditable="True" ItemsSource="{Binding FontFamilies}" Text="{Binding FontFamily, UpdateSourceTrigger=LostFocus}" ToolTip="Font" />
              <ComboBox Style="{StaticResource Quill.CommandCombo}" Width="56" ItemsSource="{Binding FontSizes}" SelectedItem="{Binding FontSize}" ToolTip="Font size" />
              <Button Style="{StaticResource Quill.IconButton}" Content="&#xE8E8;" Command="{Binding GrowFontCommand}" ToolTip="Increase font size" />
              <Button Style="{StaticResource Quill.IconButton}" Content="&#xE8E7;" Command="{Binding ShrinkFontCommand}" ToolTip="Decrease font size" />
              <Border Style="{StaticResource Quill.CommandDivider}" />
              <ToggleButton Style="{StaticResource Quill.IconToggle}" IsChecked="{Binding IsBold}" Content="&#xE8DD;" ToolTip="Bold (Ctrl+B)" />
              <ToggleButton Style="{StaticResource Quill.IconToggle}" IsChecked="{Binding IsItalic}" Content="&#xE8DB;" ToolTip="Italic (Ctrl+I)" />
              <ToggleButton Style="{StaticResource Quill.IconToggle}" IsChecked="{Binding IsUnderline}" Content="&#xE8DC;" ToolTip="Underline (Ctrl+U)" />
              <views:ColorPickerButton IsHighlight="True" GlyphText="ab" ToggleToolTip="Text highlight color" CurrentColor="{Binding HighlightSwatch}" ColorSelected="OnHighlightSelected" />
              <views:ColorPickerButton GlyphText="A" ToggleToolTip="Font color" CurrentColor="{Binding FontColor}" ColorSelected="OnFontColorSelected" />
              <Border Style="{StaticResource Quill.CommandDivider}" />
              <ToggleButton Style="{StaticResource Quill.IconToggle}" IsChecked="{Binding IsBulleted}" Content="&#xE8FD;" ToolTip="Bullets" />
              <ToggleButton Style="{StaticResource Quill.CommandToggle}" IsChecked="{Binding IsNumbered}" Content="1." Width="30" Padding="0" ToolTip="Numbering" />
              <Button Style="{StaticResource Quill.IconButton}" Content="&#xE8E3;" Command="{Binding AlignCommand}" CommandParameter="Center" ToolTip="Center (Ctrl+E)" />
              <ToggleButton Style="{StaticResource Quill.StackToggle}" Height="28" IsChecked="{Binding IsFormatPainterActive}" ToolTip="Format Painter">
                <TextBlock Text="&#xE790;" FontFamily="{StaticResource Quill.IconFont}" FontSize="13" />
              </ToggleButton>
            </StackPanel>
          </Border>
        </Popup>
      </Grid>

      <!-- Comments pane: one card per comment; the text is edited in place. -->
      <Border Grid.Column="2" Width="260" BorderThickness="1,0,0,0" BorderBrush="{StaticResource Quill.DividerBrush}"
              Visibility="{Binding ShowComments, Converter={StaticResource BoolToVis}}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Comments" FontWeight="SemiBold" Margin="10,8,10,4" />
          <TextBlock DockPanel.Dock="Top" Text="Select text and choose Insert > Comment (Ctrl+Alt+M)." Margin="10,0,10,8" Opacity="0.7" TextWrapping="Wrap"
                     Visibility="{Binding HasNoComments, Converter={StaticResource BoolToVis}}" />
          <ListBox x:Name="CommentList" ItemsSource="{Binding Comments}" SelectedItem="{Binding SelectedComment, Mode=TwoWay}"
                   BorderThickness="0" Background="Transparent" SelectionChanged="OnCommentSelected" HorizontalContentAlignment="Stretch"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border BorderThickness="1" BorderBrush="{StaticResource Quill.DividerBrush}" CornerRadius="4" Padding="8" Margin="4,3">
                  <StackPanel>
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="&#x2715;" Width="22" Height="22" Padding="0" FontSize="11" Tag="{Binding Id}" Click="OnDeleteComment" ToolTip="Delete comment" />
                      <TextBlock Text="{Binding Author}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock Text="{Binding DateText}" FontSize="11" Opacity="0.7" />
                    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" Margin="0,4,0,0" BorderThickness="0" Background="Transparent" LostFocus="OnCommentTextLostFocus" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>

</Window>
