<Window x:Class="Quill.App.Views.LinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Insert Link"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20,16,20,16">
    <TextBlock Text="Text to display:" Margin="0,0,0,4" />
    <TextBox x:Name="TextBox" Margin="0,0,0,10" />
    <TextBlock Text="Address (web page or e-mail):" Margin="0,0,0,4" />
    <TextBox x:Name="AddressBox" />
    <TextBlock x:Name="ErrorText" Foreground="#FFD13438" Margin="0,6,0,0" Visibility="Collapsed" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="RemoveButton" Content="Remove Link" Width="110" Click="OnRemove" Margin="0,0,8,0" Visibility="Collapsed" />
      <Button Content="OK" Width="90" IsDefault="True" Click="OnOk" Margin="0,0,8,0" />
      <Button Content="Cancel" Width="90" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
