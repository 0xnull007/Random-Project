<Window x:Class="Quill.App.Views.PageSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Page Setup"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style x:Key="FieldBox" TargetType="TextBox">
      <Setter Property="Width" Value="90" />
      <Setter Property="Margin" Value="0,3" />
      <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>
    <Style x:Key="UnitLabel" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="6,0,16,0" />
      <Setter Property="Opacity" Value="0.7" />
    </Style>
    <Style x:Key="GroupHeading" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,12,0,4" />
    </Style>
  </Window.Resources>

  <StackPanel Margin="20,12,20,16">
    <TextBlock Style="{StaticResource GroupHeading}" Text="Paper" Margin="0,0,0,4" />
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Size:" />
      <ComboBox Grid.Row="0" Grid.Column="1" x:Name="PaperSize" Width="200" HorizontalAlignment="Left" Margin="0,3" SelectionChanged="OnPaperSizeChanged" />
      <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Width:" />
      <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
        <TextBox x:Name="WidthBox" Style="{StaticResource FieldBox}" TextChanged="OnSizeTextChanged" />
        <TextBlock x:Name="WidthUnit" Style="{StaticResource UnitLabel}" />
        <TextBlock Style="{StaticResource FieldLabel}" Text="Height:" />
        <TextBox x:Name="HeightBox" Style="{StaticResource FieldBox}" TextChanged="OnSizeTextChanged" />
        <TextBlock x:Name="HeightUnit" Style="{StaticResource UnitLabel}" />
      </StackPanel>
      <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Orientation:" />
      <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
        <RadioButton x:Name="PortraitRadio" Content="Portrait" GroupName="Orientation" Margin="0,0,16,0" Checked="OnOrientationChanged" />
        <RadioButton x:Name="LandscapeRadio" Content="Landscape" GroupName="Orientation" Checked="OnOrientationChanged" />
      </StackPanel>
    </Grid>

    <TextBlock Style="{StaticResource GroupHeading}" Text="Margins" />
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Top:" />
      <TextBox Grid.Row="0" Grid.Column="1" x:Name="TopBox" Style="{StaticResource FieldBox}" />
      <TextBlock Grid.Row="0" Grid.Column="2" x:Name="TopUnit" Style="{StaticResource UnitLabel}" />
      <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource FieldLabel}" Text="Bottom:" />
      <TextBox Grid.Row="0" Grid.Column="4" x:Name="BottomBox" Style="{StaticResource FieldBox}" />
      <TextBlock Grid.Row="0" Grid.Column="5" x:Name="BottomUnit" Style="{StaticResource UnitLabel}" />

      <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Left:" />
      <TextBox Grid.Row="1" Grid.Column="1" x:Name="LeftBox" Style="{StaticResource FieldBox}" />
      <TextBlock Grid.Row="1" Grid.Column="2" x:Name="LeftUnit" Style="{StaticResource UnitLabel}" />
      <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource FieldLabel}" Text="Right:" />
      <TextBox Grid.Row="1" Grid.Column="4" x:Name="RightBox" Style="{StaticResource FieldBox}" />
      <TextBlock Grid.Row="1" Grid.Column="5" x:Name="RightUnit" Style="{StaticResource UnitLabel}" />

      <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Gutter:" />
      <TextBox Grid.Row="2" Grid.Column="1" x:Name="GutterBox" Style="{StaticResource FieldBox}" />
      <TextBlock Grid.Row="2" Grid.Column="2" x:Name="GutterUnit" Style="{StaticResource UnitLabel}" />
    </Grid>

    <TextBlock Style="{StaticResource GroupHeading}" Text="Headers and footers" />
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Header from top:" />
      <TextBox Grid.Column="1" x:Name="HeaderBox" Style="{StaticResource FieldBox}" />
      <TextBlock Grid.Column="2" x:Name="HeaderUnit" Style="{StaticResource UnitLabel}" />
      <TextBlock Grid.Column="3" Style="{StaticResource FieldLabel}" Text="Footer from bottom:" />
      <TextBox Grid.Column="4" x:Name="FooterBox" Style="{StaticResource FieldBox}" />
      <TextBlock Grid.Column="5" x:Name="FooterUnit" Style="{StaticResource UnitLabel}" />
    </Grid>
    <CheckBox x:Name="DifferentFirstPage" Content="Different first page" Margin="0,8,0,0" />
    <CheckBox x:Name="DifferentOddEven" Content="Different odd and even pages (whole document)" Margin="0,4,0,0" />

    <TextBlock Style="{StaticResource GroupHeading}" Text="Apply to" />
    <ComboBox x:Name="ApplyTo" Width="200" HorizontalAlignment="Left">
      <ComboBoxItem Content="This section" />
      <ComboBoxItem Content="Whole document" />
    </ComboBox>

    <TextBlock x:Name="ErrorText" Foreground="#FFD13438" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="OK" Width="90" IsDefault="True" Click="OnOk" Margin="0,0,8,0" />
      <Button Content="Cancel" Width="90" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
