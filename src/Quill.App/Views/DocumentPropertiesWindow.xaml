<Window x:Class="Quill.App.Views.DocumentPropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Document Properties"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="20,16,20,16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
      <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
    </Grid.RowDefinitions>
    <TextBlock Text="File:" Grid.Row="0" Grid.Column="0" Margin="0,0,12,8" VerticalAlignment="Center" />
    <TextBlock x:Name="FileText" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Opacity="0.85" />
    <TextBlock Text="Title:" Grid.Row="1" Grid.Column="0" Margin="0,0,12,8" VerticalAlignment="Center" />
    <TextBox x:Name="TitleBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" />
    <TextBlock Text="Author:" Grid.Row="2" Grid.Column="0" Margin="0,0,12,8" VerticalAlignment="Center" />
    <TextBox x:Name="AuthorBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" />
    <TextBlock Text="Subject:" Grid.Row="3" Grid.Column="0" Margin="0,0,12,8" VerticalAlignment="Center" />
    <TextBox x:Name="SubjectBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" />
    <TextBlock Text="Comments:" Grid.Row="4" Grid.Column="0" Margin="0,4,12,8" VerticalAlignment="Top" />
    <TextBox x:Name="CommentsBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" Height="70" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
    <TextBlock Text="Created:" Grid.Row="5" Grid.Column="0" Margin="0,0,12,4" />
    <TextBlock x:Name="CreatedText" Grid.Row="5" Grid.Column="1" Margin="0,0,0,4" Opacity="0.85" />
    <TextBlock Text="Modified:" Grid.Row="6" Grid.Column="0" Margin="0,0,12,4" />
    <TextBlock x:Name="ModifiedText" Grid.Row="6" Grid.Column="1" Margin="0,0,0,4" Opacity="0.85" />
    <TextBlock Text="Statistics:" Grid.Row="7" Grid.Column="0" Margin="0,0,12,4" />
    <TextBlock x:Name="StatisticsText" Grid.Row="7" Grid.Column="1" Margin="0,0,0,4" Opacity="0.85" TextWrapping="Wrap" />
    <StackPanel Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="OK" Width="90" IsDefault="True" Click="OnOk" Margin="0,0,8,0" />
      <Button Content="Cancel" Width="90" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
