<Window x:Class="Quill.App.Views.ShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keyboard Shortcuts"
        Width="560" Height="640" MinWidth="420" MinHeight="300"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Content="Close" Width="90" IsCancel="True" />
    </StackPanel>
    <ListView x:Name="List" BorderThickness="1">
      <ListView.View>
        <GridView>
          <GridViewColumn Header="Keys" Width="200" DisplayMemberBinding="{Binding Keys}" />
          <GridViewColumn Header="Action" Width="320" DisplayMemberBinding="{Binding Action}" />
        </GridView>
      </ListView.View>
    </ListView>
  </DockPanel>
</Window>
