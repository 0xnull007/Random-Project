<Window x:Class="Quill.App.Views.ModifyStyleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modify Style"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20,16,20,16">
    <TextBlock x:Name="NameText" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
    <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,12" />
    <StackPanel Orientation="Horizontal">
      <TextBlock Text="Style for following paragraph:" VerticalAlignment="Center" Margin="0,0,8,0" />
      <ComboBox x:Name="NextBox" Width="180" DisplayMemberPath="Name" />
    </StackPanel>
    <CheckBox x:Name="QuickBox" Content="Show in the style list" Margin="0,10,0,0" />
    <Border BorderThickness="1" BorderBrush="#40808080" Padding="12" Height="64" Background="White" Margin="0,12,0,0">
      <TextBlock x:Name="Preview" Text="The quick brown fox jumps over the lazy dog" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="Black" />
    </Border>
    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
      <Button Content="Font..." Width="100" Click="OnFont" Margin="0,0,8,0" />
      <Button Content="Paragraph..." Width="100" Click="OnParagraph" Margin="0,0,8,0" />
      <Button Content="Update to Match Selection" Width="190" Click="OnUpdateFromSelection" ToolTip="Take the formatting of the paragraph at the caret into the style" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="OK" Width="90" IsDefault="True" Click="OnOk" Margin="0,0,8,0" />
      <Button Content="Cancel" Width="90" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
