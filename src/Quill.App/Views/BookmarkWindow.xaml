<Window x:Class="Quill.App.Views.BookmarkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bookmark"
        Width="360" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20,16,20,16">
    <TextBlock Text="Bookmark name:" Margin="0,0,0,4" />
    <TextBox x:Name="NameBox" TextChanged="OnNameChanged" />
    <ListBox x:Name="NameList" Height="140" Margin="0,8,0,0" SelectionChanged="OnSelected" />
    <TextBlock Text="A name starts with a letter and uses letters, digits and underscores (no spaces)." Margin="0,6,0,0" Opacity="0.75" TextWrapping="Wrap" />
    <TextBlock x:Name="ErrorText" Foreground="#FFD13438" Margin="0,6,0,0" Visibility="Collapsed" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="AddButton" Content="Add" Width="80" IsDefault="True" Click="OnAdd" Margin="0,0,8,0" />
      <Button x:Name="DeleteButton" Content="Delete" Width="80" Click="OnDelete" Margin="0,0,8,0" />
      <Button x:Name="GoToButton" Content="Go To" Width="80" Click="OnGoTo" Margin="0,0,8,0" />
      <Button Content="Close" Width="80" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
