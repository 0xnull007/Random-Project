<Window x:Class="Quill.App.Views.SpellingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spelling"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="True"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="16,12,16,14">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="12" />
      <ColumnDefinition Width="130" />
    </Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0">
      <TextBlock Text="Not in Dictionary:" Margin="0,0,0,4" />
      <Border BorderThickness="1" BorderBrush="#60808080" Padding="8" MinHeight="72">
        <TextBlock x:Name="ContextText" TextWrapping="Wrap" />
      </Border>
      <TextBlock Text="Suggestions:" Margin="0,10,0,4" />
      <ListBox x:Name="SuggestionList" Height="140" MouseDoubleClick="OnChange" />
      <TextBlock x:Name="StatusText" Margin="0,8,0,0" Opacity="0.75" TextWrapping="Wrap" />
    </StackPanel>
    <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="0,20,0,0">
      <Button x:Name="IgnoreButton" Content="Ignore Once" Click="OnIgnore" Margin="0,0,0,6" />
      <Button x:Name="IgnoreAllButton" Content="Ignore All" Click="OnIgnoreAll" Margin="0,0,0,6" />
      <Button x:Name="AddButton" Content="Add to Dictionary" Click="OnAdd" Margin="0,0,0,18" />
      <Button x:Name="ChangeButton" Content="Change" Click="OnChange" Margin="0,0,0,6" IsDefault="True" />
      <Button x:Name="ChangeAllButton" Content="Change All" Click="OnChangeAll" Margin="0,0,0,18" />
      <Button Content="Close" Click="OnClose" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
