<Window x:Class="Quill.App.Views.FontWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Quill.App.Views"
        Title="Font"
        Width="520" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20,16,20,16">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition />
      </Grid.RowDefinitions>
      <TextBlock Text="Font:" Grid.Row="0" Grid.Column="0" Margin="0,0,0,4" />
      <ComboBox x:Name="FamilyBox" Grid.Row="1" Grid.Column="0" IsEditable="True" SelectionChanged="OnChanged" KeyUp="OnChanged" LostFocus="OnChanged" />
      <TextBlock Text="Font style:" Grid.Row="0" Grid.Column="2" Margin="0,0,0,4" />
      <ComboBox x:Name="StyleBox" Grid.Row="1" Grid.Column="2" SelectionChanged="OnChanged">
        <ComboBoxItem Content="Regular" />
        <ComboBoxItem Content="Italic" />
        <ComboBoxItem Content="Bold" />
        <ComboBoxItem Content="Bold Italic" />
      </ComboBox>
      <TextBlock Text="Size:" Grid.Row="0" Grid.Column="4" Margin="0,0,0,4" />
      <ComboBox x:Name="SizeBox" Grid.Row="1" Grid.Column="4" IsEditable="True" SelectionChanged="OnChanged" KeyUp="OnChanged" LostFocus="OnChanged" />
    </Grid>
    <Grid Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition />
      </Grid.RowDefinitions>
      <TextBlock Text="Underline style:" Grid.Row="0" Grid.Column="0" Margin="0,0,0,4" />
      <ComboBox x:Name="UnderlineBox" Grid.Row="1" Grid.Column="0" SelectionChanged="OnChanged" />
      <TextBlock Text="Font color:" Grid.Row="0" Grid.Column="2" Margin="0,0,0,4" />
      <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal">
        <views:ColorPickerButton x:Name="ColorPicker" GlyphText="A" ToggleToolTip="Font color" ColorSelected="OnColorSelected" />
        <TextBlock x:Name="ColorText" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.8" />
      </StackPanel>
    </Grid>
    <TextBlock Text="Effects:" Margin="0,14,0,4" />
    <WrapPanel>
      <CheckBox x:Name="StrikeBox" Content="Strikethrough" Margin="0,2,16,2" Click="OnChanged" />
      <CheckBox x:Name="DoubleStrikeBox" Content="Double strikethrough" Margin="0,2,16,2" Click="OnChanged" />
      <CheckBox x:Name="SuperBox" Content="Superscript" Margin="0,2,16,2" Click="OnSuperClick" />
      <CheckBox x:Name="SubBox" Content="Subscript" Margin="0,2,16,2" Click="OnSubClick" />
      <CheckBox x:Name="SmallCapsBox" Content="Small caps" Margin="0,2,16,2" Click="OnChanged" />
      <CheckBox x:Name="AllCapsBox" Content="All caps" Margin="0,2,16,2" Click="OnChanged" />
      <CheckBox x:Name="HiddenBox" Content="Hidden" Margin="0,2,16,2" Click="OnChanged" />
    </WrapPanel>
    <TextBlock Text="Preview:" Margin="0,14,0,4" />
    <Border BorderThickness="1" BorderBrush="#40808080" Padding="12" Height="64" Background="White">
      <TextBlock x:Name="Preview" Text="The quick brown fox jumps over the lazy dog" VerticalAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="Black" />
    </Border>
    <TextBlock x:Name="ErrorText" Foreground="#FFD13438" Margin="0,6,0,0" Visibility="Collapsed" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="OK" Width="90" IsDefault="True" Click="OnOk" Margin="0,0,8,0" />
      <Button Content="Cancel" Width="90" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
