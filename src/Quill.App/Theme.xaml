<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:Quill.App.Views">
  <!--
    The only place that names Fluent theme resource keys. Everything else binds to these aliases so a rename in a
    future .NET release is a one-file fix. The Fluent keys are provided by ThemeMode on the Application.
  -->
  <SolidColorBrush x:Key="Quill.CanvasBrush" Color="#FFE6E6E6" />
  <SolidColorBrush x:Key="Quill.CanvasBrushDark" Color="#FF202020" />
  <SolidColorBrush x:Key="Quill.PageBrush" Color="White" />
  <SolidColorBrush x:Key="Quill.PageBorderBrush" Color="#FFBDBDBD" />
  <SolidColorBrush x:Key="Quill.PageShadowBrush" Color="#33000000" />
  <SolidColorBrush x:Key="Quill.SelectionBrush" Color="#550078D4" />
  <SolidColorBrush x:Key="Quill.CaretBrush" Color="Black" />
  <SolidColorBrush x:Key="Quill.GuideBrush" Color="#FF0078D4" />

  <SolidColorBrush x:Key="Quill.DividerBrush" Color="#40808080" />

  <Style x:Key="Quill.CommandToggle" TargetType="ToggleButton">
    <Setter Property="AutomationProperties.Name" Value="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}" />
    <Setter Property="MinWidth" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Margin" Value="1,0" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="Quill.CommandButton" TargetType="Button">
    <Setter Property="AutomationProperties.Name" Value="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}" />
    <Setter Property="MinWidth" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Margin" Value="1,0" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="Quill.CommandCombo" TargetType="ComboBox">
    <Setter Property="Height" Value="28" />
    <Setter Property="Margin" Value="1,0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="Quill.CommandDivider" TargetType="Border">
    <Setter Property="Width" Value="1" />
    <Setter Property="Margin" Value="6,4" />
    <Setter Property="Background" Value="{StaticResource Quill.DividerBrush}" />
  </Style>

  <!-- Ribbon (Word's classic layout): groups with a caption underneath, large icon+label buttons, small icon buttons. -->
  <FontFamily x:Key="Quill.IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <Style x:Key="Quill.RibbonGroup" TargetType="HeaderedContentControl">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="HeaderedContentControl">
          <Grid Margin="2,0,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ContentPresenter Grid.Row="0" Grid.Column="0" Margin="4,2" VerticalAlignment="Center" HorizontalAlignment="Center" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="{TemplateBinding Header}" FontSize="11" Opacity="0.65" HorizontalAlignment="Center" Margin="4,0,4,2" />
            <Border Grid.Column="1" Grid.RowSpan="2" Width="1" Margin="4,8" Background="{StaticResource Quill.DividerBrush}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <DataTemplate x:Key="Quill.RibbonLargeContent">
    <StackPanel>
      <TextBlock Text="{Binding Path=(views:Ribbon.Icon), RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                 FontFamily="{StaticResource Quill.IconFont}" FontSize="22" HorizontalAlignment="Center" Margin="0,2,0,6" />
      <TextBlock Text="{Binding}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="80" LineHeight="14" LineStackingStrategy="BlockLineHeight" />
    </StackPanel>
  </DataTemplate>

  <Style x:Key="Quill.RibbonButton" TargetType="Button">
    <Setter Property="AutomationProperties.Name" Value="{Binding RelativeSource={RelativeSource Self}, Path=Content}" />
    <Setter Property="MinWidth" Value="50" />
    <Setter Property="Height" Value="70" />
    <Setter Property="Margin" Value="1,0" />
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="ContentTemplate" Value="{StaticResource Quill.RibbonLargeContent}" />
  </Style>

  <Style x:Key="Quill.RibbonToggle" TargetType="ToggleButton">
    <Setter Property="AutomationProperties.Name" Value="{Binding RelativeSource={RelativeSource Self}, Path=Content}" />
    <Setter Property="MinWidth" Value="50" />
    <Setter Property="Height" Value="70" />
    <Setter Property="Margin" Value="1,0" />
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="ContentTemplate" Value="{StaticResource Quill.RibbonLargeContent}" />
  </Style>

  <Style x:Key="Quill.IconButton" TargetType="Button" BasedOn="{StaticResource Quill.CommandButton}">
    <Setter Property="FontFamily" Value="{StaticResource Quill.IconFont}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Width" Value="30" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style x:Key="Quill.IconToggle" TargetType="ToggleButton" BasedOn="{StaticResource Quill.CommandToggle}">
    <Setter Property="FontFamily" Value="{StaticResource Quill.IconFont}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Width" Value="30" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <!-- A column of small buttons beside a large one, as in Word's Clipboard group. -->
  <Style x:Key="Quill.RibbonStack" TargetType="StackPanel">
    <Setter Property="Orientation" Value="Vertical" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="1,0" />
  </Style>

  <Style x:Key="Quill.StackButton" TargetType="Button" BasedOn="{StaticResource Quill.CommandButton}">
    <Setter Property="Height" Value="22" />
    <Setter Property="Margin" Value="0,0,0,1" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>

  <Style x:Key="Quill.StackToggle" TargetType="ToggleButton" BasedOn="{StaticResource Quill.CommandToggle}">
    <Setter Property="Height" Value="22" />
    <Setter Property="Margin" Value="0,0,0,1" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>

  <Style x:Key="Quill.StatusButton" TargetType="Button">
    <Setter Property="AutomationProperties.Name" Value="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}" />
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="12" />
  </Style>
</ResourceDictionary>
