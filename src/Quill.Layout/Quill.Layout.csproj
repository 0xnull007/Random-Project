<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>WPF-free pagination engine over ILineFormatter / IRenderTarget abstractions.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Quill.Core/Quill.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- American English hyphenation patterns (hyph-utf8's hyph-en-us, see the file header for its notice). -->
    <EmbeddedResource Include="Hyphenation/hyph-en-us.txt" LogicalName="Quill.Layout.Hyphenation.hyph-en-us.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Quill.Layout.Tests" />
    <InternalsVisibleTo Include="Quill.Layout.Wpf.Tests" />
  </ItemGroup>

</Project>
