<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- WPF0001: ThemeMode is marked experimental in .NET 9/10. We use it deliberately. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <Deterministic>true</Deterministic>
    <IsPackable>false</IsPackable>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Lets net10.0-windows projects compile (not run) on non-Windows hosts such as WSL. Harmless on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
  </PropertyGroup>

  <PropertyGroup Label="Product">
    <Product>Quill</Product>
    <Company>Quill</Company>
    <Version>0.1.0</Version>
  </PropertyGroup>

</Project>
